import "string.pace";

foreign func paceStringFromBytes(ptr: Pointer<CChar>, len: Int): String;
foreign func malloc(size: Int): Pointer<CChar>;
foreign func realloc(ptr: Pointer<CChar>, newSize: Int): Pointer<CChar>;
foreign func free(ptr: Pointer<CChar>);
foreign func ptrWriteByte(ptr: Pointer<CChar>, offset: Int, val: Int);


class StringBuilder {
    ptr: Pointer<CChar>;
    length: Int;
    capacity: Int;

    func init() {
        self.capacity = 16;
        self.length = 0;
        self.ptr = malloc(self.capacity);
    }

    func deinit() {
        if self.capacity > 0 {
            free(self.ptr);
        }
    }

    func append(s: String) {
        sLen := stringLen(s);
        if sLen == 0 {
            return;
        }

        newLen := self.length + sLen;
        if newLen > self.capacity {
            while self.capacity < newLen {
                self.capacity = self.capacity * 2;
            }
            self.ptr = realloc(self.ptr, self.capacity);
        }

        i := 0;
        while i < sLen {
            charCode := stringCharAt(s, i);
            ptrWriteByte(self.ptr, self.length + i, charCode);
            i = i + 1;
        }
        
        self.length = newLen;
    }

    func appendChar(c: Int) {
        newLen := self.length + 1;
        if newLen > self.capacity {
            while self.capacity < newLen {
                self.capacity = self.capacity * 2;
            }
            self.ptr = realloc(self.ptr, self.capacity);
        }
        ptrWriteByte(self.ptr, self.length, c);
        self.length = newLen;
    }

    func toString(): String {
        return paceStringFromBytes(self.ptr, self.length);
    }
}
