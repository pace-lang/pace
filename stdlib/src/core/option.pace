import "panic.pace";

enum Option<T> {
    Some(T),
    None

    func isSome(): Bool {
        return match self {
            Option.Some(_) => true,
            Option.None() => false,
        };
    }

    func isNone(): Bool {
        return match self {
            Option.Some(_) => false,
            Option.None() => true,
        };
    }

    func panicUnwrap(): T {
        pacePanic(1);
    }

    func unwrap(): T {
        return match self {
            Option.Some(val) => val,
            Option.None() => self.panicUnwrap(),
        };
    }

    func unwrapOr(defaultVal: T): T {
        return match self {
            Option.Some(val) => val,
            Option.None() => defaultVal,
        };
    }
}
