import "./option.pace";

foreign func arrayLen<T>(arr: [T]): Int;



extend<T> [T] {
    func len(): Int {
        return arrayLen<T>(self);
    }

    func get(index: Int): Option<T> {
        if index < 0 || index >= self.len() {
            return Option.None();
        }
        return Option.Some(self[index]);
    }

    func set(index: Int, item: T) {
        if index >= 0 {
            if index < self.len() {
                self[index] = item;
            }
        }
    }
}
