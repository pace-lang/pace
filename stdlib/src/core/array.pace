import "./option.pace";

foreign func arrayLen<T>(arr: [T]): Int;
foreign func arrayPush<T>(arr: [T], item: T);
foreign func arrayPop<T>(arr: [T]): Option<T>;
foreign func arrayGet<T>(arr: [T], index: Int): Option<T>;
foreign func arraySet<T>(arr: [T], index: Int, item: T);

func len<T>(arr: [T]): Int {
    return arrayLen<T>(arr);
}

func push<T>(arr: [T], item: T) {
    arrayPush<T>(arr, item);
}

func pop<T>(arr: [T]): Option<T> {
    return arrayPop<T>(arr);
}

func get<T>(arr: [T], index: Int): Option<T> {
    return arrayGet<T>(arr, index);
}

func set<T>(arr: [T], index: Int, item: T) {
    arraySet<T>(arr, index, item);
}
