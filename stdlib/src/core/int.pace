import "../math/math.pace";
import "option.pace";

foreign func paceIntToString(value: Int): String;
foreign func paceIntToHexString(value: Int): String;
foreign func paceIntToFloat(value: Int): Float;

foreign func bitwiseAnd(a: Int, b: Int): Int;
foreign func bitwiseOr(a: Int, b: Int): Int;
foreign func bitwiseXor(a: Int, b: Int): Int;
foreign func bitwiseNot(a: Int): Int;
foreign func bitwiseShl(a: Int, b: Int): Int;
foreign func bitwiseShr(a: Int, b: Int): Int;

extend Int {
    func abs(): Int {
        if self < 0 {
            return 0 - self;
        }
        return self;
    }

    func isEven(): Bool {
        return (self - (self / 2) * 2) == 0;
    }

    func isOdd(): Bool {
        return self.isEven() == false;
    }

    func bitAnd(other: Int): Int {
        return bitwiseAnd(self, other);
    }

    func bitOr(other: Int): Int {
        return bitwiseOr(self, other);
    }

    func bitXor(other: Int): Int {
        return bitwiseXor(self, other);
    }

    func bitNot(): Int {
        return bitwiseNot(self);
    }

    func shl(other: Int): Int {
        return bitwiseShl(self, other);
    }

    func shr(other: Int): Int {
        return bitwiseShr(self, other);
    }

    func min(other: Int): Int {
        if self < other {
            return self;
        }
        return other;
    }

    func max(other: Int): Int {
        if self > other {
            return self;
        }
        return other;
    }

    func pow(exp: Int): Int {
        return Math.pow(self.toFloat(), exp.toFloat()).toInt();
    }

    func toHexString(): String {
        return paceIntToHexString(self);
    }

    func toFloat(): Float {
        return paceIntToFloat(self);
    }

    func toString(): String {
        return paceIntToString(self);
    }
}

func parseInt(str: String): Option<Int> {
    if paceStringIsInt(str) {
        return Option.Some(paceStringToInt(str));
    }
    return Option.None();
}

foreign func paceStringToInt(str: String): Int;
foreign func paceStringIsInt(str: String): Bool;
