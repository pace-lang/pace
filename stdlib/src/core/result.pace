import "panic.pace";

enum Result<T, E> {
    Ok(T),
    Err(E)

    func isOk(): Bool {
        return match self {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        };
    }

    func isErr(): Bool {
        return match self {
            Result.Ok(_) => false,
            Result.Err(_) => true,
        };
    }

    func panicUnwrap(): T {
        pacePanic(3);
    }

    func unwrap(): T {
        return match self {
            Result.Ok(val) => val,
            Result.Err(_) => self.panicUnwrap(),
        };
    }

    func panicUnwrapErr(): E {
        pacePanic(3);
    }

    func unwrapErr(): E {
        return match self {
            Result.Ok(_) => self.panicUnwrapErr(),
            Result.Err(err) => err,
        };
    }

    func unwrapOr(defaultVal: T): T {
        return match self {
            Result.Ok(val) => val,
            Result.Err(_) => defaultVal,
        };
    }
}
