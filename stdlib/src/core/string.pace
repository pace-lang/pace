
import "../collections/list.pace";
import "string_builder.pace";

foreign func stringLen(s: String): Int;
foreign func stringConcat(a: String, b: String): String;
foreign func stringSubstring(s: String, start: Int, end: Int): String;
foreign func retainString(s: String);
foreign func stringCharAt(s: String, index: Int): Int;
foreign func stringSkipWhitespace(s: String, start: Int): Int;
foreign func stringFindStringEnd(s: String, start: Int): Int;
foreign func stringToInt(s: String): Int;
foreign func paceStringIndexOf(s: String, sub: String, start: Int): Int;
foreign func stringToFloat(s: String): Float;
foreign func paceStringToBool(s: String): Boolean;
foreign func stringFindNumberEnd(s: String, start: Int): Int;
foreign func stringMatchKeywordAt(s: String, start: Int, keyword: String): Int;
foreign func stringSubstringToInt(s: String, start: Int, end: Int): Int;
foreign func stringSubstringToFloat(s: String, start: Int, end: Int): Float;
foreign func stringNumberHasDecimal(s: String, start: Int, end: Int): Int;
extend String {
    func charCodeAt(index: Int): Int {
        return stringCharAt(self, index);
    }

    func toInt(): Int {
        return stringToInt(self);
    }

    func toFloat(): Float {
        return stringToFloat(self);
    }
    func len(): Int {
        return stringLen(self);
    }

    func concat(b: String): String {
        return stringConcat(self, b);
    }

    func substring(start: Int, end: Int): String {
        return stringSubstring(self, start, end);
    }
    
    func indexOfFrom(sub: String, start: Int): Int {
        return paceStringIndexOf(self, sub, start);
    }

    func contains(sub: String): Boolean {
        let subLen = sub.len();
        if subLen == 0 { return true; }
        let len = self.len();
        if subLen > len { return false; }

        var i = 0;
        while i <= len - subLen {
            var isMatch = true;
            var j = 0;
            while j < subLen {
                if self.charCodeAt(i + j) != sub.charCodeAt(j) {
                    isMatch = false;
                    j = subLen;
                } else {
                    j = j + 1;
                }
            }
            if isMatch {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    func split(sub: String): List<String> {
        let list = List<String>();
        let subLen = sub.len();
        if subLen == 0 {
            retainString(self);
            list.push(self);
            return list;
        }

        var i = 0;
        var start = 0;
        let len = self.len();
        
        while i <= len - subLen {
            var isMatch = true;
            var j = 0;
            while j < subLen {
                if self.charCodeAt(i + j) != sub.charCodeAt(j) {
                    isMatch = false;
                    j = subLen;
                } else {
                    j = j + 1;
                }
            }
            if isMatch {
                let part = self.substring(start, i);
                retainString(part);
                list.push(part);
                i = i + subLen;
                start = i;
            } else {
                i = i + 1;
            }
        }
        let lastPart = self.substring(start, len);
        retainString(lastPart);
        list.push(lastPart);
        return list;
    }

    func replace(old: String, newStr: String): String {
        let oldLen = old.len();
        if oldLen == 0 { return self; }
        
        let builder = StringBuilder();
        var i = 0;
        var start = 0;
        let len = self.len();
        
        while i <= len - oldLen {
            var isMatch = true;
            var j = 0;
            while j < oldLen {
                if self.charCodeAt(i + j) != old.charCodeAt(j) {
                    isMatch = false;
                    j = oldLen;
                } else {
                    j = j + 1;
                }
            }
            
            if isMatch {
                builder.append(self.substring(start, i));
                builder.append(newStr);
                i = i + oldLen;
                start = i;
            } else {
                i = i + 1;
            }
        }
        builder.append(self.substring(start, len));
        return builder.toString();
    }

    func trim(): String {
        var start = 0;
        let len = self.len();
        var continueStart = true;
        
        while continueStart {
            if start < len {
                let c = self.charCodeAt(start);
                if c == 32 { start = start + 1; }
                else if c == 10 { start = start + 1; }
                else if c == 13 { start = start + 1; }
                else if c == 9 { start = start + 1; }
                else { continueStart = false; }
            } else {
                continueStart = false;
            }
        }
        
        var end = len - 1;
        var continueEnd = true;
        while continueEnd {
            if end >= start {
                let c = self.charCodeAt(end);
                if c == 32 { end = end - 1; }
                else if c == 10 { end = end - 1; }
                else if c == 13 { end = end - 1; }
                else if c == 9 { end = end - 1; }
                else { continueEnd = false; }
            } else {
                continueEnd = false;
            }
        }
        
        if start > end { return ""; }
        return self.substring(start, end + 1);
    }

    func toLower(): String {
        let builder = StringBuilder();
        var i = 0;
        let len = self.len();
        
        while i < len {
            var c = self.charCodeAt(i);
            if c >= 65 {
                if c <= 90 {
                    c = c + 32;
                }
            }
            builder.appendChar(c);
            i = i + 1;
        }
        return builder.toString();
    }

    func toUpper(): String {
        let builder = StringBuilder();
        var i = 0;
        let len = self.len();
        
        while i < len {
            var c = self.charCodeAt(i);
            if c >= 97 {
                if c <= 122 {
                    c = c - 32;
                }
            }
            builder.appendChar(c);
            i = i + 1;
        }
        return builder.toString();
    }

    func isEmpty(): Boolean {
        return self.len() == 0;
    }

    func toBool(): Boolean {
        return paceStringToBool(self);
    }

    func startsWith(prefix: String): Boolean {
        let prefixLen = prefix.len();
        if prefixLen == 0 { return true; }
        let len = self.len();
        if prefixLen > len { return false; }

        var i = 0;
        while i < prefixLen {
            if self.charCodeAt(i) != prefix.charCodeAt(i) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    func endsWith(suffix: String): Boolean {
        let suffixLen = suffix.len();
        if suffixLen == 0 { return true; }
        let len = self.len();
        if suffixLen > len { return false; }

        var i = 0;
        let offset = len - suffixLen;
        while i < suffixLen {
            if self.charCodeAt(offset + i) != suffix.charCodeAt(i) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    func indexOf(sub: String): Int {
        let subLen = sub.len();
        if subLen == 0 { return 0; }
        let len = self.len();
        if subLen > len { return -1; }

        var i = 0;
        while i <= len - subLen {
            var isMatch = true;
            var j = 0;
            while j < subLen {
                if self.charCodeAt(i + j) != sub.charCodeAt(j) {
                    isMatch = false;
                    j = subLen;
                } else {
                    j = j + 1;
                }
            }
            if isMatch {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
}
