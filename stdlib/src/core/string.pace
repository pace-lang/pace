
import "../collections/list.pace" show List;

foreign func stringLen(s: String): Int;
foreign func stringConcat(a: String, b: String): String;
foreign func stringSubstring(s: String, start: Int, end: Int): String;
foreign func stringContains(s: String, sub: String): Boolean;

foreign func stringReplace(s: String, old: String, new: String): String;
foreign func stringTrim(s: String): String;
foreign func stringToLower(s: String): String;
foreign func stringToUpper(s: String): String;
foreign func stringSplitRaw(s: String, sub: String): Pointer<CChar>;

extend String {
    public func len(): Int {
        return stringLen(self);
    }

    public func concat(b: String): String {
        return stringConcat(self, b);
    }

    public func substring(start: Int, end: Int): String {
        return stringSubstring(self, start, end);
    }

    public func contains(sub: String): Boolean {
        return stringContains(self, sub);
    }

    public func split(sub: String): List<String> {
        let list = List<String>();
        list.ptr = stringSplitRaw(self, sub);
        return list;
    }

    public func replace(old: String, new: String): String {
        return stringReplace(self, old, new);
    }

    public func trim(): String {
        return stringTrim(self);
    }

    public func toLower(): String {
        return stringToLower(self);
    }

    public func toUpper(): String {
        return stringToUpper(self);
    }
}
