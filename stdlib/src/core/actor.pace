import "task.pace";
import "../collections/list.pace";

class Mailbox {
    queue: List<Pointer<CChar>>;
    waker: Pointer<CChar>;
    
    func init() {
        self.queue = List<Pointer<CChar>>();
        self.waker = paceNullPointer();
    }
    
    // push a message into the mailbox
    func push(msg: Pointer<CChar>) {
        self.queue.push(msg);
        
        // If the actor is suspended waiting for a message, wake it up!
        if self.waker != paceNullPointer() {
            paceWakerWake(self.waker);
            self.waker = paceNullPointer();
        }
    }
}

class Actor {
    var mailbox: Mailbox;
    
    func init() {
        self.mailbox = Mailbox();
    }
}
