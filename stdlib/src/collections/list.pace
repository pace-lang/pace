import "../core/option.pace";
// Raw C-runtime allocation bindings
foreign func malloc(size: Int): Pointer<CChar>;
foreign func realloc(ptr: Pointer<CChar>, newSize: Int): Pointer<CChar>;
foreign func free(ptr: Pointer<CChar>);

// Compiler Intrinsics (Zero FFI)
foreign func ptrRead<T>(ptr: Pointer<CChar>, offset: Int): T;
foreign func ptrWrite<T>(ptr: Pointer<CChar>, offset: Int, val: T);
foreign func sizeof<T>(): Int;
foreign func equals<T>(a: T, b: T): Boolean;

class List<T> {
    var ptr: Pointer<CChar>;
    var length: Int;
    var capacity: Int;

    func init() {
        self.capacity = 8;
        self.length = 0;
        self.ptr = malloc(self.capacity * sizeof<T>());
    }

    func deinit() {
        if self.capacity > 0 {
            free(self.ptr);
        }
    }

    func push(value: T) {
        if self.length >= self.capacity {
            self.capacity = self.capacity * 2;
            self.ptr = realloc(self.ptr, self.capacity * sizeof<T>());
        }
        ptrWrite<T>(self.ptr, self.length, value);
        self.length = self.length + 1;
    }

    func pop(): Option<T> {
        if self.length == 0 {
            return Option.None();
        }
        self.length = self.length - 1;
        let val = ptrRead<T>(self.ptr, self.length);
        return Option.Some(val);
    }

    func get(index: Int): Option<T> {
        if index < 0 {
            return Option.None();
        }
        if index >= self.length {
            return Option.None();
        }
        let val = ptrRead<T>(self.ptr, index);
        return Option.Some(val);
    }

    func set(index: Int, value: T) {
        if index >= 0 {
            if index < self.length {
                ptrWrite<T>(self.ptr, index, value);
            }
        }
    }
    
    // Unsafe get for testing Data Locality without Enum boxing overhead
    func getUnsafe(index: Int): T {
        return ptrRead<T>(self.ptr, index);
    }

    func len(): Int {
        return self.length;
    }

    func clear() {
        self.length = 0;
    }

    func remove(index: Int): Option<T> {
        if index < 0 {
            return Option.None();
        }
        if index >= self.length {
            return Option.None();
        }
        
        let val = ptrRead<T>(self.ptr, index);
        
        // Shift elements to the left
        var i = index;
        while i < self.length - 1 {
            let nextVal = ptrRead<T>(self.ptr, i + 1);
            ptrWrite<T>(self.ptr, i, nextVal);
            i = i + 1;
        }
        
        self.length = self.length - 1;
        return Option.Some(val);
    }

    func isEmpty(): Boolean {
        return self.length == 0;
    }

    func contains(value: T): Boolean {
        var i = 0;
        while i < self.length {
            let v = ptrRead<T>(self.ptr, i);
            if equals<T>(v, value) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    func indexOf(value: T): Int {
        var i = 0;
        while i < self.length {
            let v = ptrRead<T>(self.ptr, i);
            if equals<T>(v, value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    func insert(index: Int, value: T) {
        if index < 0 || index > self.length {
            return;
        }
        if self.length >= self.capacity {
            self.capacity = self.capacity * 2;
            self.ptr = realloc(self.ptr, self.capacity * sizeof<T>());
        }
        var i = self.length;
        while i > index {
            let prevVal = ptrRead<T>(self.ptr, i - 1);
            ptrWrite<T>(self.ptr, i, prevVal);
            i = i - 1;
        }
        ptrWrite<T>(self.ptr, index, value);
        self.length = self.length + 1;
    }

    func first(): Option<T> {
        if self.length == 0 {
            return Option.None();
        }
        let val = ptrRead<T>(self.ptr, 0);
        return Option.Some(val);
    }

    func last(): Option<T> {
        if self.length == 0 {
            return Option.None();
        }
        let val = ptrRead<T>(self.ptr, self.length - 1);
        return Option.Some(val);
    }

    func reverse() {
        var left = 0;
        var right = self.length - 1;
        while left < right {
            let lVal = ptrRead<T>(self.ptr, left);
            let rVal = ptrRead<T>(self.ptr, right);
            ptrWrite<T>(self.ptr, left, rVal);
            ptrWrite<T>(self.ptr, right, lVal);
            left = left + 1;
            right = right - 1;
        }
    }
}

