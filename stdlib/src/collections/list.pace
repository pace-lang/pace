import "../core/option.pace";

foreign func listInit<T>(): Pointer<CChar>;
foreign func listPush<T>(ptr: Pointer<CChar>, value: T);
foreign func listPopRaw<T>(ptr: Pointer<CChar>): T;
foreign func listGetRaw<T>(ptr: Pointer<CChar>, index: Int): T;
foreign func listSet<T>(ptr: Pointer<CChar>, index: Int, value: T);
foreign func listLen<T>(ptr: Pointer<CChar>): Int;
foreign func listClear<T>(ptr: Pointer<CChar>);
foreign func listRemoveRaw<T>(ptr: Pointer<CChar>, index: Int): T;

class List<T> {
    var ptr: Pointer<CChar>;

    func init() {
        self.ptr = listInit<T>();
    }

    func push(value: T) {
        listPush<T>(self.ptr, value);
    }

    func pop(): Option<T> {
        if self.len() == 0 {
            return Option.None();
        }
        let val = listPopRaw<T>(self.ptr);
        return Option.Some(val);
    }

    func get(index: Int): Option<T> {
        if index < 0 {
            return Option.None();
        }
        if index >= self.len() {
            return Option.None();
        }
        let val = listGetRaw<T>(self.ptr, index);
        return Option.Some(val);
    }

    func set(index: Int, value: T) {
        listSet<T>(self.ptr, index, value);
    }

    func len(): Int {
        return listLen<T>(self.ptr);
    }

    func clear() {
        listClear<T>(self.ptr);
    }

    func remove(index: Int): Option<T> {
        if index < 0 {
            return Option.None();
        }
        if index >= self.len() {
            return Option.None();
        }
        let val = listRemoveRaw<T>(self.ptr, index);
        return Option.Some(val);
    }
}
