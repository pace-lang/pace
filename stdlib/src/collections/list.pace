import "../core/option.pace";
import "../core/iterable.pace";
import "../core/iterator.pace";
// Raw C-runtime allocation bindings
foreign func malloc(size: Int): Pointer<CChar>;
foreign func realloc(ptr: Pointer<CChar>, newSize: Int): Pointer<CChar>;
foreign func free(ptr: Pointer<CChar>);

// Compiler Intrinsics (Zero FFI)
foreign func ptrRead<T>(ptr: Pointer<CChar>, offset: Int): T;
foreign func ptrWrite<T>(ptr: Pointer<CChar>, offset: Int, val: T);
foreign func sizeof<T>(): Int;
foreign func hash<T>(val: T): Int;
foreign func paceRetainRef<T>(val: T);
foreign func paceReleaseRef<T>(val: T);

class List<T> implements Iterable<T> {
    ptr: Pointer<CChar>;
    length: Int;
    capacity: Int;

    func init() {
        self.capacity = 8;
        self.length = 0;
        self.ptr = malloc(self.capacity * sizeof<T>());
    }

    func deinit() {
        if self.capacity > 0 {
            i := 0;
            while i < self.length {
                final val := ptrRead<T>(self.ptr, i);
                paceReleaseRef<T>(val);
                i = i + 1;
            }
            free(self.ptr);
        }
    }

    func push(value: T) {
        if self.length >= self.capacity {
            self.capacity = self.capacity * 2;
            self.ptr = realloc(self.ptr, self.capacity * sizeof<T>());
        }
        paceRetainRef<T>(value);
        ptrWrite<T>(self.ptr, self.length, value);
        self.length = self.length + 1;
    }

    func pop(): Option<T> {
        if self.length == 0 {
            return Option.None();
        }
        self.length = self.length - 1;
        final val := ptrRead<T>(self.ptr, self.length);
        return Option.Some(val);
    }

    func get(index: Int): Option<T> {
        if index < 0 {
            return Option.None();
        }
        if index >= self.length {
            return Option.None();
        }
        final val := ptrRead<T>(self.ptr, index);
        return Option.Some(val);
    }

    func set(index: Int, value: T) {
        if index >= 0 {
            if index < self.length {
                final oldVal := ptrRead<T>(self.ptr, index);
                paceReleaseRef<T>(oldVal);
                paceRetainRef<T>(value);
                ptrWrite<T>(self.ptr, index, value);
            }
        }
    }
    
    // Unsafe get for testing Data Locality without Enum boxing overhead
    func getUnsafe(index: Int): T {
        return ptrRead<T>(self.ptr, index);
    }

    func len(): Int {
        return self.length;
    }

    func clear() {
        i := 0;
        while i < self.length {
            final val := ptrRead<T>(self.ptr, i);
            paceReleaseRef<T>(val);
            i = i + 1;
        }
        self.length = 0;
    }

    func remove(index: Int): Option<T> {
        if index < 0 {
            return Option.None();
        }
        if index >= self.length {
            return Option.None();
        }
        
        final val := ptrRead<T>(self.ptr, index);
        
        // Shift elements to the left
        i := index;
        while i < self.length - 1 {
            final nextVal := ptrRead<T>(self.ptr, i + 1);
            ptrWrite<T>(self.ptr, i, nextVal);
            i = i + 1;
        }
        
        self.length = self.length - 1;
        // Don't release val here, as it's being returned and ownership is passed
        return Option.Some(val);
    }

    func isEmpty(): Bool {
        return self.length == 0;
    }

    func contains(value: T): Bool {
        i := 0;
        while i < self.length {
            final v := ptrRead<T>(self.ptr, i);
            if v == value {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    func indexOf(value: T): Int {
        i := 0;
        while i < self.length {
            final v := ptrRead<T>(self.ptr, i);
            if v == value {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    func insert(index: Int, value: T) {
        if index < 0 || index > self.length {
            return;
        }
        if self.length >= self.capacity {
            self.capacity = self.capacity * 2;
            self.ptr = realloc(self.ptr, self.capacity * sizeof<T>());
        }
        i := self.length;
        while i > index {
            final prevVal := ptrRead<T>(self.ptr, i - 1);
            ptrWrite<T>(self.ptr, i, prevVal);
            i = i - 1;
        }
        paceRetainRef<T>(value);
        ptrWrite<T>(self.ptr, index, value);
        self.length = self.length + 1;
    }

    func first(): Option<T> {
        if self.length == 0 {
            return Option.None();
        }
        final val := ptrRead<T>(self.ptr, 0);
        return Option.Some(val);
    }

    func last(): Option<T> {
        if self.length == 0 {
            return Option.None();
        }
        final val := ptrRead<T>(self.ptr, self.length - 1);
        return Option.Some(val);
    }

    func reverse() {
        left := 0;
        right := self.length - 1;
        while left < right {
            final lVal := ptrRead<T>(self.ptr, left);
            final rVal := ptrRead<T>(self.ptr, right);
            ptrWrite<T>(self.ptr, left, rVal);
            ptrWrite<T>(self.ptr, right, lVal);
            left = left + 1;
            right = right - 1;
        }
    }

    func iter(): Iterator<T> {
        return ListIterator<T>(self);
    }
}

class ListIterator<T> implements Iterator<T> {
    list: List<T>;
    index: Int;
    
    func init(list: List<T>) {
        self.list = list;
        self.index = 0;
    }
    
    func next(): Option<T> {
        if self.index < self.list.len() {
            final val := self.list.getUnsafe(self.index);
            self.index = self.index + 1;
            return Option.Some(val);
        }
        return Option.None();
    }
}
