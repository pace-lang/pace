import "../core/option.pace";

foreign func listInit<T>() -> Pointer<CChar>;
foreign func listPush<T>(ptr: Pointer<CChar>, value: T);
foreign func listPop<T>(ptr: Pointer<CChar>) -> Option<T>;
foreign func listGet<T>(ptr: Pointer<CChar>, index: Int) -> Option<T>;
foreign func listSet<T>(ptr: Pointer<CChar>, index: Int, value: T);
foreign func listLen<T>(ptr: Pointer<CChar>) -> Int;
foreign func listClear<T>(ptr: Pointer<CChar>);
foreign func listRemove<T>(ptr: Pointer<CChar>, index: Int) -> Option<T>;

class List<T> {
    var ptr: Pointer<CChar>;

    func init() {
        self.ptr = listInit<T>();
    }

    func push(value: T) {
        listPush<T>(self.ptr, value);
    }

    func pop() -> Option<T> {
        return listPop<T>(self.ptr);
    }

    func get(index: Int) -> Option<T> {
        return listGet<T>(self.ptr, index);
    }

    func set(index: Int, value: T) {
        listSet<T>(self.ptr, index, value);
    }

    func len() -> Int {
        return listLen<T>(self.ptr);
    }

    func clear() {
        listClear<T>(self.ptr);
    }

    func remove(index: Int) -> Option<T> {
        return listRemove<T>(self.ptr, index);
    }
}
