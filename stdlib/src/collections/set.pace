import "../core/option.pace";
import "list.pace";




class Set<T> {
    itemPtr: Pointer<CChar>;
    statePtr: Pointer<CChar>; // 0: empty, 1: filled, 2: deleted
    capacity: Int;
    length: Int;

    func init() {
        self.capacity = 16;
        self.length = 0;
        self.itemPtr = malloc(self.capacity * sizeof<T>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());
        i := 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
    }

    func deinit() {
        if self.capacity > 0 {
            free(self.itemPtr);
            free(self.statePtr);
            self.capacity = 0;
        }
    }

    func resize(newCapacity: Int) {
        final oldItems := self.itemPtr;
        final oldStates := self.statePtr;
        final oldCapacity := self.capacity;

        self.capacity = newCapacity;
        self.length = 0;
        self.itemPtr = malloc(self.capacity * sizeof<T>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());

        i := 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }

        i = 0;
        while i < oldCapacity {
            final state := ptrRead<Int>(oldStates, i);
            if state == 1 {
                final v := ptrRead<T>(oldItems, i);
                self.insert(v);
            }
            i = i + 1;
        }

        free(oldItems);
        free(oldStates);
    }

    func insert(value: T) {
        if self.length * 2 >= self.capacity {
            self.resize(self.capacity * 2);
        }

        h := hash<T>(value);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                ptrWrite<T>(self.itemPtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 2 {
                ptrWrite<T>(self.itemPtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 1 {
                final existingVal := ptrRead<T>(self.itemPtr, index);
                if existingVal == value {
                    return; // already exists
                }
            }
            index = (index + 1) % self.capacity;
        }
    }

    func contains(value: T): Bool {
        h := hash<T>(value);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;
        startIndex := index;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return false;
            } else if state == 1 {
                final existingVal := ptrRead<T>(self.itemPtr, index);
                if existingVal == value {
                    return true;
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return false;
            }
        }
        return false;
    }

    func remove(value: T): Bool {
        h := hash<T>(value);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;
        startIndex := index;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return false;
            } else if state == 1 {
                final existingVal := ptrRead<T>(self.itemPtr, index);
                if existingVal == value {
                    ptrWrite<Int>(self.statePtr, index, 2);
                    self.length = self.length - 1;
                    return true;
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return false;
            }
        }
        return false;
    }

    func clear() {
        i := 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
        self.length = 0;
    }

    func values(): List<T> {
        final list := List<T>();
        i := 0;
        while i < self.capacity {
            final state := ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                list.push(ptrRead<T>(self.itemPtr, i));
            }
            i = i + 1;
        }
        return list;
    }

    func len(): Int {
        return self.length;
    }

    func isEmpty(): Bool {
        return self.length == 0;
    }
}
