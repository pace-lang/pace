import "../core/option.pace";
import "list.pace";



foreign func hash<T>(val: T): Int;
foreign func equals<T>(a: T, b: T): Boolean;

class Set<T> {
    var itemPtr: Pointer<CChar>;
    var statePtr: Pointer<CChar>; // 0: empty, 1: filled, 2: deleted
    var capacity: Int;
    var length: Int;

    func init() {
        self.capacity = 16;
        self.length = 0;
        self.itemPtr = malloc(self.capacity * sizeof<T>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());
        var i = 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
    }

    func deinit() {
        if self.capacity > 0 {
            free(self.itemPtr);
            free(self.statePtr);
            self.capacity = 0;
        }
    }

    func resize(newCapacity: Int) {
        let oldItems = self.itemPtr;
        let oldStates = self.statePtr;
        let oldCapacity = self.capacity;

        self.capacity = newCapacity;
        self.length = 0;
        self.itemPtr = malloc(self.capacity * sizeof<T>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());

        var i = 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }

        i = 0;
        while i < oldCapacity {
            let state = ptrRead<Int>(oldStates, i);
            if state == 1 {
                let v = ptrRead<T>(oldItems, i);
                self.insert(v);
            }
            i = i + 1;
        }

        free(oldItems);
        free(oldStates);
    }

    func insert(value: T) {
        if self.length * 2 >= self.capacity {
            self.resize(self.capacity * 2);
        }

        var h = hash<T>(value);
        if h < 0 {
            h = 0 - h;
        }
        var index = h % self.capacity;

        while true {
            let state = ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                ptrWrite<T>(self.itemPtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 2 {
                ptrWrite<T>(self.itemPtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 1 {
                let existingVal = ptrRead<T>(self.itemPtr, index);
                if equals<T>(existingVal, value) {
                    return; // already exists
                }
            }
            index = (index + 1) % self.capacity;
        }
    }

    func contains(value: T): Boolean {
        var h = hash<T>(value);
        if h < 0 {
            h = 0 - h;
        }
        var index = h % self.capacity;
        var startIndex = index;

        while true {
            let state = ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return false;
            } else if state == 1 {
                let existingVal = ptrRead<T>(self.itemPtr, index);
                if equals<T>(existingVal, value) {
                    return true;
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return false;
            }
        }
        return false;
    }

    func remove(value: T): Boolean {
        var h = hash<T>(value);
        if h < 0 {
            h = 0 - h;
        }
        var index = h % self.capacity;
        var startIndex = index;

        while true {
            let state = ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return false;
            } else if state == 1 {
                let existingVal = ptrRead<T>(self.itemPtr, index);
                if equals<T>(existingVal, value) {
                    ptrWrite<Int>(self.statePtr, index, 2);
                    self.length = self.length - 1;
                    return true;
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return false;
            }
        }
        return false;
    }

    func clear() {
        var i = 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
        self.length = 0;
    }

    func values(): List<T> {
        let list = List<T>();
        var i = 0;
        while i < self.capacity {
            let state = ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                list.push(ptrRead<T>(self.itemPtr, i));
            }
            i = i + 1;
        }
        return list;
    }

    func len(): Int {
        return self.length;
    }

    func isEmpty(): Boolean {
        return self.length == 0;
    }
}
