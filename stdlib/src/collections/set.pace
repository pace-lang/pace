import "list.pace" show List;

foreign func setInit<T>(): Pointer<CChar>;
foreign func setInsert<T>(ptr: Pointer<CChar>, val: T);
foreign func setRemove<T>(ptr: Pointer<CChar>, val: T);
foreign func setContains<T>(ptr: Pointer<CChar>, val: T): Boolean;
foreign func setClear<T>(ptr: Pointer<CChar>);
foreign func setLen<T>(ptr: Pointer<CChar>): Int;
foreign func setValuesLen<T>(ptr: Pointer<CChar>): Int;
foreign func setValueAt<T>(ptr: Pointer<CChar>, index: Int): T;
foreign func setFree(ptr: Pointer<CChar>);

class Set<T> {
    var ptr: Pointer<CChar>;

    func init() {
        self.ptr = setInit<T>();
    }

    func deinit() {
        setFree(self.ptr);
    }

    func insert(val: T) {
        setInsert<T>(self.ptr, val);
    }

    func remove(val: T) {
        setRemove<T>(self.ptr, val);
    }

    func contains(val: T): Boolean {
        return setContains<T>(self.ptr, val);
    }

    func clear() {
        setClear<T>(self.ptr);
    }

    func len(): Int {
        return setLen<T>(self.ptr);
    }

    func values(): List<T> {
        let list = List<T>();
        let len = setValuesLen<T>(self.ptr);
        var i = 0;
        while i < len {
            list.push(setValueAt<T>(self.ptr, i));
            i = i + 1;
        }
        return list;
    }
}
