import "../core/option.pace" show Option;
import "list.pace" show List;

foreign func mapInit<K, V>(): Pointer<CChar>; // Opaque pointer to underlying map
foreign func mapSet<K, V>(ptr: Pointer<CChar>, key: K, value: V);
foreign func mapGetRaw<K, V>(ptr: Pointer<CChar>, key: K): V;
foreign func mapRemove<K, V>(ptr: Pointer<CChar>, key: K);
foreign func mapContains<K, V>(ptr: Pointer<CChar>, key: K): Boolean;
foreign func mapClear<K, V>(ptr: Pointer<CChar>);
foreign func mapKeysRaw<K, V>(ptr: Pointer<CChar>): Pointer<CChar>;
foreign func mapValuesRaw<K, V>(ptr: Pointer<CChar>): Pointer<CChar>;

class Map<K, V> {
    var ptr: Pointer<CChar>;

    func init() {
        self.ptr = mapInit<K, V>();
    }

    func set(key: K, value: V) {
        mapSet<K, V>(self.ptr, key, value);
    }

    func get(key: K): Option<V> {
        if self.contains(key) == false {
            return Option.None();
        }
        let val = mapGetRaw<K, V>(self.ptr, key);
        return Option.Some(val);
    }

    func remove(key: K) {
        mapRemove<K, V>(self.ptr, key);
    }

    func contains(key: K): Boolean {
        return mapContains<K, V>(self.ptr, key);
    }

    func clear() {
        mapClear<K, V>(self.ptr);
    }

    func keys(): List<K> {
        let list = List<K>();
        list.ptr = mapKeysRaw<K, V>(self.ptr);
        return list;
    }

    func values(): List<V> {
        let list = List<V>();
        list.ptr = mapValuesRaw<K, V>(self.ptr);
        return list;
    }
}
