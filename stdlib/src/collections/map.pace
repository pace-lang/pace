import "../core/option.pace";
import "list.pace";




class Map<K, V> {
    keyPtr: Pointer<CChar>;
    valuePtr: Pointer<CChar>;
    statePtr: Pointer<CChar>;
    capacity: Int;
    length: Int;

    func init() {
        self.capacity = 16;
        self.length = 0;
        self.keyPtr = malloc(self.capacity * sizeof<K>());
        self.valuePtr = malloc(self.capacity * sizeof<V>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());
        i := 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
    }

    func deinit() {
        if self.capacity > 0 {
            i := 0;
            while i < self.capacity {
                final state := ptrRead<Int>(self.statePtr, i);
                if state == 1 {
                    final k := ptrRead<K>(self.keyPtr, i);
                    final v := ptrRead<V>(self.valuePtr, i);
                    paceReleaseRef<K>(k);
                    paceReleaseRef<V>(v);
                }
                i = i + 1;
            }
            free(self.keyPtr);
            free(self.valuePtr);
            free(self.statePtr);
            self.capacity = 0;
        }
    }

    func resize(newCapacity: Int) {
        final oldKeys := self.keyPtr;
        final oldValues := self.valuePtr;
        final oldStates := self.statePtr;
        final oldCapacity := self.capacity;

        self.capacity = newCapacity;
        self.length = 0;
        self.keyPtr = malloc(self.capacity * sizeof<K>());
        self.valuePtr = malloc(self.capacity * sizeof<V>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());

        i := 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }

        i = 0;
        while i < oldCapacity {
            final state := ptrRead<Int>(oldStates, i);
            if state == 1 {
                final k := ptrRead<K>(oldKeys, i);
                final v := ptrRead<V>(oldValues, i);
                // Directly set without retain/release, as we are just moving elements
                self.setInternalMove(k, v);
            }
            i = i + 1;
        }

        free(oldKeys);
        free(oldValues);
        free(oldStates);
    }

    func set(key: K, value: V) {
        if self.length * 2 >= self.capacity {
            self.resize(self.capacity * 2);
        }

        h := hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                paceRetainRef<K>(key);
                paceRetainRef<V>(value);
                ptrWrite<K>(self.keyPtr, index, key);
                ptrWrite<V>(self.valuePtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 2 {
                paceRetainRef<K>(key);
                paceRetainRef<V>(value);
                ptrWrite<K>(self.keyPtr, index, key);
                ptrWrite<V>(self.valuePtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 1 {
                final existingKey := ptrRead<K>(self.keyPtr, index);
                if existingKey == key {
                    final oldVal := ptrRead<V>(self.valuePtr, index);
                    paceReleaseRef<V>(oldVal);
                    paceRetainRef<V>(value);
                    ptrWrite<V>(self.valuePtr, index, value);
                    return;
                }
            }
            index = (index + 1) % self.capacity;
        }
    }

    func setInternalMove(key: K, value: V) {
        h := hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 || state == 2 {
                ptrWrite<K>(self.keyPtr, index, key);
                ptrWrite<V>(self.valuePtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            }
            index = (index + 1) % self.capacity;
        }
    }

    func get(key: K): Option<V> {
        h := hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;
        startIndex := index;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return Option.None();
            } else if state == 1 {
                final existingKey := ptrRead<K>(self.keyPtr, index);
                if existingKey == key {
                    final v := ptrRead<V>(self.valuePtr, index);
                    return Option.Some(v);
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return Option.None();
            }
        }
        return Option.None();
    }

    func contains(key: K): Bool {
        final opt := self.get(key);
        return opt.isSome();
    }

    func remove(key: K): Option<V> {
        h := hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        index := h % self.capacity;
        startIndex := index;

        while true {
            final state := ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return Option.None();
            } else if state == 1 {
                final existingKey := ptrRead<K>(self.keyPtr, index);
                if existingKey == key {
                    ptrWrite<Int>(self.statePtr, index, 2);
                    self.length = self.length - 1;
                    final existingVal := ptrRead<V>(self.valuePtr, index);
                    // Don't release existingVal, as it's returned to caller
                    final existingK := ptrRead<K>(self.keyPtr, index);
                    paceReleaseRef<K>(existingK);
                    return Option.Some(existingVal);
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return Option.None();
            }
        }
        return Option.None();
    }

    func clear() {
        i := 0;
        while i < self.capacity {
            final state := ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                final k := ptrRead<K>(self.keyPtr, i);
                final v := ptrRead<V>(self.valuePtr, i);
                paceReleaseRef<K>(k);
                paceReleaseRef<V>(v);
            }
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
        self.length = 0;
    }

    func keys(): List<K> {
        final list := List<K>();
        i := 0;
        while i < self.capacity {
            final state := ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                list.push(ptrRead<K>(self.keyPtr, i));
            }
            i = i + 1;
        }
        return list;
    }

    func values(): List<V> {
        final list := List<V>();
        i := 0;
        while i < self.capacity {
            final state := ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                list.push(ptrRead<V>(self.valuePtr, i));
            }
            i = i + 1;
        }
        return list;
    }

    func len(): Int {
        return self.length;
    }

    func isEmpty(): Bool {
        return self.length == 0;
    }
}
