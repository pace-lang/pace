import "../core/option.pace";
import "list.pace";



foreign func hash<T>(val: T): Int;
foreign func equals<T>(a: T, b: T): Boolean;

class Map<K, V> {
    var keyPtr: Pointer<CChar>;
    var valuePtr: Pointer<CChar>;
    var statePtr: Pointer<CChar>;
    var capacity: Int;
    var length: Int;

    func init() {
        self.capacity = 16;
        self.length = 0;
        self.keyPtr = malloc(self.capacity * sizeof<K>());
        self.valuePtr = malloc(self.capacity * sizeof<V>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());
        var i = 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
    }

    func deinit() {
        if self.capacity > 0 {
            free(self.keyPtr);
            free(self.valuePtr);
            free(self.statePtr);
            self.capacity = 0;
        }
    }

    func resize(newCapacity: Int) {
        let oldKeys = self.keyPtr;
        let oldValues = self.valuePtr;
        let oldStates = self.statePtr;
        let oldCapacity = self.capacity;

        self.capacity = newCapacity;
        self.length = 0;
        self.keyPtr = malloc(self.capacity * sizeof<K>());
        self.valuePtr = malloc(self.capacity * sizeof<V>());
        self.statePtr = malloc(self.capacity * sizeof<Int>());

        var i = 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }

        i = 0;
        while i < oldCapacity {
            let state = ptrRead<Int>(oldStates, i);
            if state == 1 {
                let k = ptrRead<K>(oldKeys, i);
                let v = ptrRead<V>(oldValues, i);
                self.set(k, v);
            }
            i = i + 1;
        }

        free(oldKeys);
        free(oldValues);
        free(oldStates);
    }

    func set(key: K, value: V) {
        if self.length * 2 >= self.capacity {
            self.resize(self.capacity * 2);
        }

        var h = hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        var index = h % self.capacity;

        while true {
            let state = ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                ptrWrite<K>(self.keyPtr, index, key);
                ptrWrite<V>(self.valuePtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 2 {
                ptrWrite<K>(self.keyPtr, index, key);
                ptrWrite<V>(self.valuePtr, index, value);
                ptrWrite<Int>(self.statePtr, index, 1);
                self.length = self.length + 1;
                return;
            } else if state == 1 {
                let existingKey = ptrRead<K>(self.keyPtr, index);
                if equals<K>(existingKey, key) {
                    ptrWrite<V>(self.valuePtr, index, value);
                    return;
                }
            }
            index = (index + 1) % self.capacity;
        }
    }

    func get(key: K): Option<V> {
        var h = hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        var index = h % self.capacity;
        var startIndex = index;

        while true {
            let state = ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return Option.None();
            } else if state == 1 {
                let existingKey = ptrRead<K>(self.keyPtr, index);
                if equals<K>(existingKey, key) {
                    let v = ptrRead<V>(self.valuePtr, index);
                    return Option.Some(v);
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return Option.None();
            }
        }
        return Option.None();
    }

    func contains(key: K): Boolean {
        let opt = self.get(key);
        return opt.isSome();
    }

    func remove(key: K): Option<V> {
        var h = hash<K>(key);
        if h < 0 {
            h = 0 - h;
        }
        var index = h % self.capacity;
        var startIndex = index;

        while true {
            let state = ptrRead<Int>(self.statePtr, index);
            if state == 0 {
                return Option.None();
            } else if state == 1 {
                let existingKey = ptrRead<K>(self.keyPtr, index);
                if equals<K>(existingKey, key) {
                    ptrWrite<Int>(self.statePtr, index, 2);
                    self.length = self.length - 1;
                    let existingVal = ptrRead<V>(self.valuePtr, index);
                    return Option.Some(existingVal);
                }
            }
            index = (index + 1) % self.capacity;
            if index == startIndex {
                return Option.None();
            }
        }
        return Option.None();
    }

    func clear() {
        var i = 0;
        while i < self.capacity {
            ptrWrite<Int>(self.statePtr, i, 0);
            i = i + 1;
        }
        self.length = 0;
    }

    func keys(): List<K> {
        let list = List<K>();
        var i = 0;
        while i < self.capacity {
            let state = ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                list.push(ptrRead<K>(self.keyPtr, i));
            }
            i = i + 1;
        }
        return list;
    }

    func values(): List<V> {
        let list = List<V>();
        var i = 0;
        while i < self.capacity {
            let state = ptrRead<Int>(self.statePtr, i);
            if state == 1 {
                list.push(ptrRead<V>(self.valuePtr, i));
            }
            i = i + 1;
        }
        return list;
    }

    func len(): Int {
        return self.length;
    }

    func isEmpty(): Boolean {
        return self.length == 0;
    }
}
