
import "../core/result.pace";

foreign func fileOpen(path: String, mode: String) -> Pointer<CChar>; // Opaque FILE*
foreign func fileReadAll(ptr: Pointer<CChar>) -> String;
foreign func fileWrite(ptr: Pointer<CChar>, data: String) -> Int;
foreign func fileClose(ptr: Pointer<CChar>);
foreign func fileIsValid(ptr: Pointer<CChar>) -> Boolean;

class File {
    var ptr: Pointer<CChar>;

    init(ptr: Pointer<CChar>) {
        self.ptr = ptr;
    }

    func readAll() -> Result<String, String> {
        if fileIsValid(self.ptr) == false {
            return Err("Invalid file handle");
        }
        return Ok(fileReadAll(self.ptr));
    }

    func write(data: String) -> Result<Int, String> {
        if fileIsValid(self.ptr) == false {
            return Err("Invalid file handle");
        }
        return Ok(fileWrite(self.ptr, data));
    }

    func close() {
        if fileIsValid(self.ptr) {
            fileClose(self.ptr);
        }
    }
}

func open(path: String, mode: String) -> Result<File, String> {
    let ptr = fileOpen(path, mode);
    if fileIsValid(ptr) == false {
        return Err("Failed to open file");
    }
    return Ok(File(ptr));
}
