
import "../core/result.pace";

foreign func fileOpen(path: String, mode: String): Pointer<CChar>;
foreign func fileReadAll(ptr: Pointer<CChar>): String;
foreign func fileWrite(ptr: Pointer<CChar>, data: String);
foreign func fileClose(ptr: Pointer<CChar>);
foreign func fileIsValid(ptr: Pointer<CChar>): Bool;

class File {
    var ptr: Pointer<CChar>;

    func init(ptr: Pointer<CChar>) {
        self.ptr = ptr;
    }

    func readAll(): Result<String, String> {
        if fileIsValid(self.ptr) {
            return Result.Ok(fileReadAll(self.ptr));
        } else {
            return Result.Err("Invalid file handle");
        }
    }

    func write(data: String): Result<Bool, String> {
        if fileIsValid(self.ptr) {
            fileWrite(self.ptr, data);
            return Result.Ok(true);
        } else {
            return Result.Err("Invalid file handle");
        }
    }

    func close() {
        if fileIsValid(self.ptr) {
            fileClose(self.ptr);
        }
    }
}

func open(path: String, mode: String): Result<File, String> {
    let ptr = fileOpen(path, mode);
    if fileIsValid(ptr) {
        return Result.Ok(File(ptr));
    } else {
        return Result.Err("Failed to open file");
    }
}
