import "../core/string.pace";
import "../core/task.pace";

foreign func paceTcpBind(addr: String): Pointer<CChar>;
foreign func paceTcpConnect(addr: String): Pointer<CChar>;
foreign func paceTlsConnect(addr: String, domain: String): Pointer<CChar>;
foreign func paceTcpAccept(listener: Pointer<CChar>): Pointer<CChar>;
foreign func paceTcpRead(stream: Pointer<CChar>, buf: Pointer<CChar>, len: Int): Int;
foreign func paceTcpWrite(stream: Pointer<CChar>, buf: Pointer<CChar>, len: Int): Int;
foreign func paceTcpWriteString(stream: Pointer<CChar>, str: String): Int;
foreign func paceTcpReadString(stream: Pointer<CChar>, max_len: Int): String;
foreign func paceTcpClose(stream: Pointer<CChar>);
foreign func paceTcpListenerClose(listener: Pointer<CChar>);

class TlsStream {
    ptr: Pointer<CChar>;
    
    func init() {
        self.ptr = paceNullPointer();
    }
    
    func connect(addr: String, domain: String): Bool {
        self.ptr = paceTlsConnect(addr, domain);
        return self.ptr != paceNullPointer();
    }
    
    func writeString(str: String): Int {
        if self.ptr == paceNullPointer() { return -1; }
        return paceTcpWriteString(self.ptr, str); // It uses the same read/write FFI!
    }
    
    func readString(maxLen: Int): String {
        if self.ptr == paceNullPointer() { return ""; }
        return paceTcpReadString(self.ptr, maxLen);
    }
    
    func close() {
        if self.ptr != paceNullPointer() {
            paceTcpClose(self.ptr);
            self.ptr = paceNullPointer();
        }
    }
}

class TcpStream {
    ptr: Pointer<CChar>;
    
    func init() {
        self.ptr = paceNullPointer();
    }
    
    func connect(addr: String): Bool {
        self.ptr = paceTcpConnect(addr);
        return self.ptr != paceNullPointer();
    }
    
    func read(buf: Pointer<CChar>, len: Int): Int {
        if self.ptr == paceNullPointer() { return -1; }
        return paceTcpRead(self.ptr, buf, len);
    }
    
    func write(buf: Pointer<CChar>, len: Int): Int {
        if self.ptr == paceNullPointer() { return -1; }
        return paceTcpWrite(self.ptr, buf, len);
    }
    
    func writeString(str: String): Int {
        if self.ptr == paceNullPointer() { return -1; }
        return paceTcpWriteString(self.ptr, str);
    }
    
    func readString(maxLen: Int): String {
        if self.ptr == paceNullPointer() { return ""; }
        return paceTcpReadString(self.ptr, maxLen);
    }
    
    func close() {
        if self.ptr != paceNullPointer() {
            paceTcpClose(self.ptr);
            self.ptr = paceNullPointer();
        }
    }
    
    func deinit() {
        self.close();
    }
}

class TcpListener {
    ptr: Pointer<CChar>;
    
    func init() {
        self.ptr = paceNullPointer();
    }
    
    func bind(addr: String): Bool {
        self.ptr = paceTcpBind(addr);
        return self.ptr != paceNullPointer();
    }
    
    func accept(): TcpStream {
        if self.ptr == paceNullPointer() { return TcpStream(); }
        final clientPtr := paceTcpAccept(self.ptr);
        final stream := TcpStream();
        stream.ptr = clientPtr;
        return stream;
    }
    
    func close() {
        if self.ptr != paceNullPointer() {
            paceTcpListenerClose(self.ptr);
            self.ptr = paceNullPointer();
        }
    }
    
    func deinit() {
        self.close();
    }
}
