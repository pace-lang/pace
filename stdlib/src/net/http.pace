import "../core/string.pace";
import "../core/result.pace";

// Client FFI
foreign func httpClientCreateWithOptions(timeoutSecs: Int, userAgent: String): Pointer<CChar>;
foreign func httpClientFree(ptr: Pointer<CChar>);
foreign func httpRequestCreate(method: String, url: String): Pointer<CChar>;
foreign func httpRequestAddHeader(req: Pointer<CChar>, key: String, val: String);
foreign func httpRequestSetBody(req: Pointer<CChar>, body: String);
foreign func httpRequestFree(ptr: Pointer<CChar>);
foreign func httpClientSend(agent: Pointer<CChar>, req: Pointer<CChar>): Pointer<CChar>;

foreign func httpResponseGetStatus(ptr: Pointer<CChar>): Int;
foreign func httpResponseGetBody(ptr: Pointer<CChar>): String;
foreign func httpResponseGetHeader(ptr: Pointer<CChar>, key: String): String;
foreign func httpResponseFree(ptr: Pointer<CChar>);
foreign func httpResponseIsValid(ptr: Pointer<CChar>): Boolean;

class HttpResponse {
    var status: Int;
    var body: String;
    var ptr: Pointer<CChar>;
    
    func init(status: Int, body: String, ptr: Pointer<CChar>) {
        self.status = status;
        self.body = body;
        self.ptr = ptr;
    }

    func getHeader(key: String): String {
        return httpResponseGetHeader(self.ptr, key);
    }

    func free() {
        httpResponseFree(self.ptr);
    }
}

class HttpRequest {
    var ptr: Pointer<CChar>;

    func init(method: String, url: String) {
        self.ptr = httpRequestCreate(method, url);
    }

    func addHeader(key: String, value: String): HttpRequest {
        httpRequestAddHeader(self.ptr, key, value);
        return self;
    }

    func setBody(body: String): HttpRequest {
        httpRequestSetBody(self.ptr, body);
        return self;
    }

    func free() {
        httpRequestFree(self.ptr);
    }
}

class HttpClientOptions {
    var timeoutSecs: Int;
    var userAgent: String;

    func init(timeoutSecs: Int, userAgent: String) {
        self.timeoutSecs = timeoutSecs;
        self.userAgent = userAgent;
    }
}

class HttpClient {
    var ptr: Pointer<CChar>;

    func init(options: HttpClientOptions) {
        self.ptr = httpClientCreateWithOptions(options.timeoutSecs, options.userAgent);
    }


    func send(req: HttpRequest): Result<HttpResponse, String> {
        let respPtr = httpClientSend(self.ptr, req.ptr);
        
        if httpResponseIsValid(respPtr) == false {
            return Result.Err("HTTP Request Failed or Network Error");
        }
        
        let status = httpResponseGetStatus(respPtr);
        let body = httpResponseGetBody(respPtr);
        
        let resp = HttpResponse(status, body, respPtr);
        return Result.Ok(resp);
    }

    func close() {
        httpClientFree(self.ptr);
    }
}

func httpGetRequest(url: String): Result<HttpResponse, String> {
    let client = HttpClient(HttpClientOptions(30, "pace-http-client"));
    let req = HttpRequest("GET", url);
    let result = client.send(req);
    // Don't free the req here as it gets consumed/kept by FFI logic or should be freed explicitly by user.
    return result;
}

// ---------------------------------------------------------
// HTTP SERVER
// ---------------------------------------------------------

foreign func httpServerBind(addr: String): Pointer<CChar>;
foreign func httpServerAccept(serverPtr: Pointer<CChar>): Pointer<CChar>;
foreign func httpServerFree(serverPtr: Pointer<CChar>);
foreign func httpRequestGetPath(reqPtr: Pointer<CChar>): String;
foreign func httpRequestMethod(reqPtr: Pointer<CChar>): String;
foreign func httpRequestGetHeader(reqPtr: Pointer<CChar>, key: String): String;
foreign func httpRequestGetBody(reqPtr: Pointer<CChar>): String;
foreign func httpRequestGetQuery(reqPtr: Pointer<CChar>, key: String): String;
foreign func httpRequestRespond(reqPtr: Pointer<CChar>, respPtr: Pointer<CChar>);
foreign func httpServerResponseCreate(status: Int, body: String): Pointer<CChar>;
foreign func httpServerResponseAddHeader(respPtr: Pointer<CChar>, key: String, val: String);

class HttpServerResponse {
    var ptr: Pointer<CChar>;
    
    func init(status: Int, body: String) {
        self.ptr = httpServerResponseCreate(status, body);
    }
    
    func addHeader(key: String, value: String): HttpServerResponse {
        httpServerResponseAddHeader(self.ptr, key, value);
        return self;
    }
}

class HttpServerRequest {
    var method: String;
    var path: String;
    var ptr: Pointer<CChar>;
    
    func init(method: String, path: String, ptr: Pointer<CChar>) {
        self.method = method;
        self.path = path;
        self.ptr = ptr;
    }

    func getHeader(key: String): String {
        return httpRequestGetHeader(self.ptr, key);
    }
    
    func getBody(): String {
        return httpRequestGetBody(self.ptr);
    }
    
    func getQuery(key: String): String {
        return httpRequestGetQuery(self.ptr, key);
    }
    
    func respond(status: Int, body: String) {
        let resp = HttpServerResponse(status, body);
        httpRequestRespond(self.ptr, resp.ptr);
    }

    func respondWith(resp: HttpServerResponse) {
        httpRequestRespond(self.ptr, resp.ptr);
    }
}

class HttpServer {
    var ptr: Pointer<CChar>;
    
    func init(ptr: Pointer<CChar>) {
        self.ptr = ptr;
    }
    
    func accept(): HttpServerRequest {
        let reqPtr = httpServerAccept(self.ptr);
        let path = httpRequestGetPath(reqPtr);
        let method = httpRequestMethod(reqPtr);
        return HttpServerRequest(method, path, reqPtr);
    }
    
    func close() {
        httpServerFree(self.ptr);
    }
}

func bindHttpServer(addr: String): HttpServer {
    let ptr = httpServerBind(addr);
    return HttpServer(ptr);
}
