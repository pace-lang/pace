import "../core/string.pace";
import "../core/string_builder.pace";
import "../collections/list.pace";
import "socket.pace";

class HttpServerResponse {
    var status: Int;
    var body: String;
    var headers: List<String>;
    
    func init(status: Int, body: String) {
        self.status = status;
        self.body = body;
        self.headers = List<String>();
    }
    
    func addHeader(key: String, value: String) {
        self.headers.push(key + ": " + value);
    }
    
    func toString(): String {
        let builder = StringBuilder();
        builder.append("HTTP/1.1 ");
        builder.append(self.status.toString());
        if self.status == 200 {
            builder.append(" OK\r\n");
        } else if self.status == 404 {
            builder.append(" Not Found\r\n");
        } else {
            builder.append(" Unknown\r\n");
        }
        
        var i = 0;
        while i < self.headers.len() {
            builder.append(self.headers.get(i).unwrap());
            builder.append("\r\n");
            i = i + 1;
        }
        
        builder.append("Content-Length: ");
        builder.append(self.body.len().toString());
        builder.append("\r\n\r\n");
        builder.append(self.body);
        
        return builder.toString();
    }
}

class HttpRequest {
    var method: String;
    var path: String;
    var stream: TcpStream;
    
    func init() {
        self.method = "";
        self.path = "";
        self.stream = TcpStream();
    }
    
    func respondWith(resp: HttpServerResponse) {
        let respStr = resp.toString();
        self.stream.writeString(respStr);
        self.stream.close();
    }
}

class HttpServer {
    var listener: TcpListener;
    
    func init() {
        self.listener = TcpListener();
    }
    
    func bind(addr: String): Boolean {
        return self.listener.bind(addr);
    }
    
    func accept(): HttpRequest {
        let stream = self.listener.accept();
        let req = HttpRequest();
        req.stream = stream;
        
        let requestStr = stream.readString(4096);
        if requestStr != "" {
            let parts = requestStr.split(" ");
            if parts.len() >= 2 {
                req.method = parts.get(0).unwrap();
                req.path = parts.get(1).unwrap();
            }
        }
        return req;
    }
    
    func close() {
        self.listener.close();
    }
}

func bindHttpServer(addr: String): HttpServer {
    let server = HttpServer();
    let success = server.bind(addr);
    if success == false {
        print("Failed to bind server");
    }
    return server;
}

class ClientHttpRequest {
    var method: String;
    var url: String;
    
    func init(method: String, url: String) {
        self.method = method;
        self.url = url;
    }
}

class HttpResult {
    var ok: Boolean;
    var value: HttpServerResponse;
    
    func init(ok: Boolean, value: HttpServerResponse) {
        self.ok = ok;
        self.value = value;
    }
    
    func isOk(): Boolean {
        return self.ok;
    }
    
    func unwrap(): HttpServerResponse {
        return self.value;
    }
}

class HttpClientOptions {
    var timeout: Int;
    var userAgent: String;
    
    func init(timeout: Int, userAgent: String) {
        self.timeout = timeout;
        self.userAgent = userAgent;
    }
}

class HttpClient {
    var options: HttpClientOptions;
    
    func init(options: HttpClientOptions) {
        self.options = options;
    }
    
    func send(req: ClientHttpRequest): HttpResult {
        let isHttps = req.url.contains("https://");
        var domain = "";
        var path = "/";
        var port = "";
        
        var urlStrip = "";
        if isHttps {
            urlStrip = req.url.substring(8, req.url.len());
            port = "443";
        } else {
            urlStrip = req.url.substring(7, req.url.len());
            port = "80";
        }
        
        // Find path
        let parts = urlStrip.split("/");
        if parts.len() > 0 {
            domain = parts.get(0).unwrap();
        }
        if parts.len() > 1 {
            path = "/" + parts.get(1).unwrap();
        }
        
        let addr = domain + ":" + port;
        let requestStr = req.method + " " + path + " HTTP/1.1\r\nHost: " + domain + "\r\nUser-Agent: " + self.options.userAgent + "\r\nConnection: close\r\n\r\n";
        
        var responseStr = "";
        if isHttps {
            let stream = TlsStream();
            if stream.connect(addr, domain) {
                stream.writeString(requestStr);
                responseStr = stream.readString(65536);
                stream.close();
            }
        } else {
            let stream = TcpStream();
            if stream.connect(addr) {
                stream.writeString(requestStr);
                responseStr = stream.readString(65536);
                stream.close();
            }
        }
        
        if responseStr == "" {
            return HttpResult(false, HttpServerResponse(0, ""));
        }
        
        // Parse HTTP/1.1 200 OK
        var status = 0;
        let lines = responseStr.split("\r\n");
        if lines.len() > 0 {
            let firstLine = lines.get(0).unwrap();
            let firstLineParts = firstLine.split(" ");
            if firstLineParts.len() >= 2 {
                status = firstLineParts.get(1).unwrap().toInt();
            }
        }
        
        let resp = HttpServerResponse(status, responseStr);
        return HttpResult(true, resp);
    }
    
    func close() {
        // Nothing to close for now
    }
}
