import "json.pace";
import "../core/string.pace";
import "../core/string_builder.pace";

func stringifyJson(value: JsonValue): String {
    let builder = StringBuilder();
    stringifyJsonBuilder(value, builder);
    return builder.toString();
}

func stringifyJsonBuilder(value: JsonValue, builder: StringBuilder) {
    match value {
        JsonValue.Null() => builder.append("null"),
        JsonValue.Boolean(b) => builder.append(b.toString()),
        JsonValue.NumberInt(i) => builder.append(i.toString()),
        JsonValue.NumberFloat(f) => builder.append(f.toString()),
        JsonValue.String(s) => stringifyStringNode(s, builder),
        JsonValue.Array(list) => stringifyArrayBuilder(list, builder),
        JsonValue.Object(map) => stringifyObjectBuilder(map, builder)
    }
}

func stringifyStringNode(s: String, builder: StringBuilder) {
    builder.append("\"");
    builder.append(s);
    builder.append("\"");
}

func stringifyArrayBuilder(list: List<JsonValue>, builder: StringBuilder) {
    builder.append("[");
    let len = list.len();
    var i = 0;
    while i < len {
        stringifyJsonBuilder(list.get(i).unwrap(), builder);
        if i < len - 1 {
            builder.append(",");
        }
        i = i + 1;
    }
    builder.append("]");
}

func stringifyObjectBuilder(map: Map<String, JsonValue>, builder: StringBuilder) {
    builder.append("{");
    let keys = map.keys();
    let len = keys.len();
    var i = 0;
    while i < len {
        let key = keys.get(i).unwrap();
        let val = map.get(key).unwrap();
        builder.append("\"");
        builder.append(key);
        builder.append("\":");
        stringifyJsonBuilder(val, builder);
        if i < len - 1 {
            builder.append(",");
        }
        i = i + 1;
    }
    builder.append("}");
}
