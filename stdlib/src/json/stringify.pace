import "json.pace";
import "../core/string.pace";

func stringifyJson(value: JsonValue): String {
    return match value {
        JsonValue.Null() => "null",
        JsonValue.Boolean(b) => b.toString(),
        JsonValue.NumberInt(i) => i.toString(),
        JsonValue.NumberFloat(f) => f.toString(),
        JsonValue.String(s) => "\"".concat(s).concat("\""),
        JsonValue.Array(list) => stringifyArray(list),
        JsonValue.Object(map) => stringifyObject(map)
    };
}

func stringifyArray(list: List<JsonValue>): String {
    var result = "[";
    let len = list.len();
    var i = 0;
    while i < len {
        result = result.concat(stringifyJson(list.get(i).unwrap()));
        if i < len - 1 {
            result = result.concat(",");
        }
        i = i + 1;
    }
    return result.concat("]");
}

func stringifyObject(map: Map<String, JsonValue>): String {
    var result = "{";
    let keys = map.keys();
    let len = keys.len();
    var i = 0;
    while i < len {
        let key = keys.get(i).unwrap();
        let val = map.get(key).unwrap();
        result = result.concat("\"").concat(key).concat("\":").concat(stringifyJson(val));
        if i < len - 1 {
            result = result.concat(",");
        }
        i = i + 1;
    }
    return result.concat("}");
}
