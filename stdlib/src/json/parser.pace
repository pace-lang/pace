import "json.pace";
import "../core/result.pace";
import "../core/string.pace";
import "../collections/map.pace";
import "../collections/list.pace";

class JsonParser {
    var source: String;
    var pos: Int;
    var len: Int;

    func init(source: String) {
        self.source = source;
        self.pos = 0;
        self.len = source.len();
    }

    func parse(): Result<JsonValue, String> {
        self.pos = stringSkipWhitespace(self.source, self.pos);
        if self.pos >= self.len {
            return Result.Err("Empty JSON");
        }
        let value = self.parseValue();
        self.pos = stringSkipWhitespace(self.source, self.pos);
        if self.pos < self.len {
            return Result.Err("Unexpected trailing characters");
        }
        return Result.Ok(value);
    }

    func parseValue(): JsonValue {
        self.pos = stringSkipWhitespace(self.source, self.pos);
        let c = self.source.charCodeAt(self.pos);
        
        if c == 123 { // '{'
            return self.parseObject();
        }
        if c == 91 { // '['
            return self.parseArray();
        }
        if c == 34 { // '"'
            return self.parseString();
        }
        if c == 116 { // 't'
            self.matchKeyword("true");
            return JsonValue.Boolean(true);
        }
        if c == 102 { // 'f'
            self.matchKeyword("false");
            return JsonValue.Boolean(false);
        }
        if c == 110 { // 'n'
            self.matchKeyword("null");
            return JsonValue.Null();
        }
        
        var isNum = false;
        if c >= 48 {
            if c <= 57 {
                isNum = true;
            }
        }
        if c == 45 {
            isNum = true;
        }

        if isNum { // '0'-'9' or '-'
            return self.parseNumber();
        }
        
        return JsonValue.Null();
    }

    func matchKeyword(expected: String) {
        let expectedLen = expected.len();
        let matched = stringMatchKeywordAt(self.source, self.pos, expected);
        if matched == 1 {
            self.pos = self.pos + expectedLen;
        }
    }

    func parseString(): JsonValue {
        self.pos = self.pos + 1; // skip '"'
        let start = self.pos;
        
        let end = stringFindStringEnd(self.source, self.pos);
        if end == -1 {
            return JsonValue.String("");
        }
        
        self.pos = end + 1; // skip ending '"'
        
        if end > start {
            let str = self.source.substring(start, end);
            return JsonValue.String(str);
        }
        return JsonValue.String("");
    }

    func parseNumber(): JsonValue {
        let start = self.pos;
        let end = stringFindNumberEnd(self.source, start);
        if end <= start { return JsonValue.Null(); }
        
        self.pos = end;
        
        let hasDecimal = stringNumberHasDecimal(self.source, start, end) == 1;
        
        if hasDecimal {
            return JsonValue.NumberFloat(stringSubstringToFloat(self.source, start, end));
        } else {
            return JsonValue.NumberInt(stringSubstringToInt(self.source, start, end));
        }
    }

    func parseArray(): JsonValue {
        self.pos = self.pos + 1; // skip '['
        let list = List<JsonValue>();
        self.pos = stringSkipWhitespace(self.source, self.pos);
        
        if self.source.charCodeAt(self.pos) == 93 { // ']'
            self.pos = self.pos + 1;
            return JsonValue.Array(list);
        }
        
        var parseMore = true;
        while parseMore {
            list.push(self.parseValue());
            
            self.pos = stringSkipWhitespace(self.source, self.pos);
            let c = self.source.charCodeAt(self.pos);
            if c == 44 { // ','
                self.pos = self.pos + 1;
            } else {
                parseMore = false;
            }
        }
        
        if self.source.charCodeAt(self.pos) == 93 {
            self.pos = self.pos + 1;
        }
        
        return JsonValue.Array(list);
    }

    func parseObject(): JsonValue {
        self.pos = self.pos + 1; // skip '{'
        let map = Map<String, JsonValue>();
        self.pos = stringSkipWhitespace(self.source, self.pos);
        
        if self.source.charCodeAt(self.pos) == 125 { // '}'
            self.pos = self.pos + 1;
            return JsonValue.Object(map);
        }
        
        var parseMore = true;
        while parseMore {
            self.pos = stringSkipWhitespace(self.source, self.pos);
            let keyNode = self.parseString();
            let keyStr = match keyNode {
                JsonValue.String(s) => s,
                _ => "",
            };
            
            self.pos = stringSkipWhitespace(self.source, self.pos);
            if self.source.charCodeAt(self.pos) == 58 { // ':'
                self.pos = self.pos + 1;
            }
            
            let valNode = self.parseValue();
            map.set(keyStr, valNode);
            
            self.pos = stringSkipWhitespace(self.source, self.pos);
            let c = self.source.charCodeAt(self.pos);
            if c == 44 { // ','
                self.pos = self.pos + 1;
            } else {
                parseMore = false;
            }
        }
        
        if self.source.charCodeAt(self.pos) == 125 {
            self.pos = self.pos + 1;
        }
        
        return JsonValue.Object(map);
    }
}

func parseJson(source: String): Result<JsonValue, String> {
    let parser = JsonParser(source);
    return parser.parse();
}

extend String {
    func parseJson(): Result<JsonValue, String> {
        return parseJson(self);
    }
}
