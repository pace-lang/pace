import "./list";
import "./map";
import "../string-builder";
import "pace:core/iterator";

class Set<T> implement Iterable<T> {
    // Standard Dynamic Set Implementation
    // Uses a Map internally for O(1) deduplication
    var _map: Map<T, Bool>;

    func init() {
        self._map = Map<T, Bool>();
        self._map.init();
    }

    func iterator() -> Iterator<T> {
        return SetIterator<T>(self);
    }

    func add(val: T) -> Bool {
        if self._map.containsKey(val) {
            return false;
        }
        self._map.set(val, true);
        return true;
    }

    func addAll(other: Iterable<T>) {
        let it = other.iterator();
        while it.hasNext() {
            self.add(it.next());
        }
    }

    func getList() -> List<T> {
        return self._map.keys();
    }

    func remove(val: T) -> Bool {
        return self._map.remove(val);
    }

    func clear() {
        self._map.clear();
    }

    func contains(val: T) -> Bool {
        return self._map.containsKey(val);
    }

    func length() -> Int {
        return self._map.length();
    }

    func isEmpty() -> Bool {
        return self._map.isEmpty();
    }

    func isNotEmpty() -> Bool {
        return self._map.isNotEmpty();
    }

    func first() -> T {
        return self._map.keys().first();
    }

    func last() -> T {
        return self._map.keys().last();
    }

    func union(other: Set<T>) -> Set<T> {
        let newSet = Set<T>();
        newSet.addAll(self);
        newSet.addAll(other);
        return newSet;
    }

    func intersection(other: Set<T>) -> Set<T> {
        let newSet = Set<T>();
        let keys = self._map.keys();
        var i = 0;
        while i < keys.length() {
            let item = keys.get(i);
            if other.contains(item) {
                newSet.add(item);
            }
            i = i + 1;
        }
        return newSet;
    }

    func toString() -> String {
        let sb = StringBuilder();
        sb.init();
        sb.append("[");
        let keys = self._map.keys();
        var i = 0;
        while i < keys.length() {
            sb.append(keys.get(i).toString());
            if i < keys.length() - 1 {
                sb.append(", ");
            }
            i = i + 1;
        }
        sb.append("]");
        return sb.build();
    }

    func drop() {
        self._map.drop();
    }
}

class SetIterator<T> implement Iterator<T> {
    var set: Set<T>;
    var listIterator: Iterator<T>;

    func init(set: Set<T>) {
        self.set = set;
        self.listIterator = set.getList().iterator();
    }

    func hasNext() -> Bool {
        return self.listIterator.hasNext();
    }

    func next() -> T {
        return self.listIterator.next();
    }
}

