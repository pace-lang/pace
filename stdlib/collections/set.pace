import "./list";

// Standard Dynamic Set Implementation
// Uses a List internally and deduplicates on insert

class Set<T> implement Iterable<T> {
    var list: List<T>;

    func init() {
        self.list = List<T>();
    }

    func insert(val: T) -> Bool {
        var i = 0;
        let len = self.list.length();
        while i < len {
            if self.list.get(i) == val {
                return false;
            }
            i = i + 1;
        }
        self.list.push(val);
        return true;
    }

    func contains(val: T) -> Bool {
        var i = 0;
        let len = self.list.length();
        while i < len {
            if self.list.get(i) == val {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    func length() -> Int {
        return self.list.length();
    }
}
