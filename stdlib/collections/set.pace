import "./list";

// Standard Dynamic Set Implementation
// Uses a List internally and deduplicates on insert

class Set<T> implement Iterable<T> {
    var list: List<T>;

    func init() {
        self.list = List<T>();
    }

    func add(val: T) -> Bool {
        if self.list.contains(val) {
            return false;
        }
        self.list.add(val);
        return true;
    }
    
    func addAll(other: List<T>) {
        var i = 0;
        let l = other.length();
        while i < l {
            self.add(other.get(i));
            i = i + 1;
        }
    }
    
    func remove(val: T) -> Bool {
        let idx = self.list.indexOf(val);
        if idx >= 0 {
            self.list.remove(idx);
            return true;
        }
        return false;
    }
    
    func clear() {
        self.list.clear();
    }

    func contains(val: T) -> Bool {
        return self.list.contains(val);
    }

    func length() -> Int {
        return self.list.length();
    }
    
    func union(other: Set<T>) -> Set<T> {
        let newSet = Set<T>();
        var i = 0;
        while i < self.length() {
            newSet.add(self.list.get(i));
            i = i + 1;
        }
        var j = 0;
        while j < other.length() {
            newSet.add(other.list.get(j));
            j = j + 1;
        }
        return newSet;
    }
    
    func intersection(other: Set<T>) -> Set<T> {
        let newSet = Set<T>();
        var i = 0;
        while i < self.length() {
            let item = self.list.get(i);
            if other.contains(item) {
                newSet.add(item);
            }
            i = i + 1;
        }
        return newSet;
    }
}
