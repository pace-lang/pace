import "./list";

class Map<K, V> implement Iterable<K> {
    // True Hash-based Map Implementation with Linear Probing
    var keysPtr: Int;
    var valsPtr: Int;
    var statesPtr: Int;
    var count: Int;
    var cap: Int;

    func init() {
        self.cap = 16;
        self.count = 0;
        self.keysPtr = malloc(self.cap * 8);
        self.valsPtr = malloc(self.cap * 8);
        self.statesPtr = malloc(self.cap * 8);

        var i = 0;
        while i < self.cap {
            ptrStore(self.statesPtr, i * 8, 0);
            i = i + 1;
        }
    }

    func _resize() {
        let oldCap = self.cap;
        let oldKeys = self.keysPtr;
        let oldVals = self.valsPtr;
        let oldStates = self.statesPtr;

        self.cap = self.cap * 2;
        self.keysPtr = malloc(self.cap * 8);
        self.valsPtr = malloc(self.cap * 8);
        self.statesPtr = malloc(self.cap * 8);

        var i = 0;
        while i < self.cap {
            ptrStore(self.statesPtr, i * 8, 0);
            i = i + 1;
        }

        i = 0;
        while i < oldCap {
            if ptrLoad(oldStates, i * 8) == 1 {
                let k = ptrLoad(oldKeys, i * 8);
                let v = ptrLoad(oldVals, i * 8);
                var index = hash(k) % self.cap;
                if index < 0 {
                    index = index * (0 - 1);
                }
                while ptrLoad(self.statesPtr, index * 8) == 1 {
                    index = (index + 1) % self.cap;
                }
                ptrStore(self.keysPtr, index * 8, k);
                ptrStore(self.valsPtr, index * 8, v);
                ptrStore(self.statesPtr, index * 8, 1);
            }
            i = i + 1;
        }

        free(oldKeys, oldCap * 8);
        free(oldVals, oldCap * 8);
        free(oldStates, oldCap * 8);
    }

    func put(key: K, val: V) {
        if self.count * 2 >= self.cap {
            self._resize();
        }

        var index = hash(key) % self.cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        var firstDeleted = 0 - 1;

        while true {
            let state = ptrLoad(self.statesPtr, index * 8);
            if state == 0 {
                // Empty slot found
                var targetIdx = index;
                if firstDeleted != 0 - 1 {
                    targetIdx = firstDeleted;
                }
                __pace_retain_generic<K>(key);
                __pace_retain_generic<V>(val);
                ptrStore(self.keysPtr, targetIdx * 8, key);
                ptrStore(self.valsPtr, targetIdx * 8, val);
                ptrStore(self.statesPtr, targetIdx * 8, 1);
                self.count = self.count + 1;
                return;
            }
            if state == 1 {
                let k = ptrLoad(self.keysPtr, index * 8);
                if k == key {
                    // Overwrite existing
                    let oldVal = ptrLoad(self.valsPtr, index * 8);
                    __pace_release_generic<V>(oldVal);
                    __pace_retain_generic<V>(val);
                    ptrStore(self.valsPtr, index * 8, val);
                    return;
                }
            }
            if state == 2 {
                if firstDeleted == 0 - 1 {
                    firstDeleted = index;
                }
            }
            index = (index + 1) % self.cap;
        }
    }

    func putAll(other: Map<K, V>) {
        let keys = other.keys();
        var i = 0;
        let l = keys.length();
        while i < l {
            let k = keys.get(i);
            self.put(k, other.get(k));
            i = i + 1;
        }
    }

    func remove(key: K) -> Bool {
        if self.cap == 0 { return false; }
        var index = hash(key) % self.cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        while true {
            let state = ptrLoad(self.statesPtr, index * 8);
            if state == 0 {
                return false;
            }
            if state == 1 {
                let k = ptrLoad(self.keysPtr, index * 8);
                if k == key {
                    ptrStore(self.statesPtr, index * 8, 2); // Mark deleted
                    __pace_release_generic<K>(ptrLoad(self.keysPtr, index * 8));
                    __pace_release_generic<V>(ptrLoad(self.valsPtr, index * 8));
                    self.count = self.count - 1;
                    return true;
                }
            }
            index = (index + 1) % self.cap;
        }
        return false;
    }

    func get(k: K) -> V {
        if self.cap == 0 {
            return ptrLoad(self.valsPtr, 0); // Null/default fallback
        }
        var index = hash(k) % self.cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        while true {
            let state = ptrLoad(self.statesPtr, index * 8);
            if state == 0 {
                return ptrLoad(self.valsPtr, 0); // Null/default fallback
            }
            if state == 1 {
                let current_k = ptrLoad(self.keysPtr, index * 8);
                if current_k == k {
                    return ptrLoad(self.valsPtr, index * 8);
                }
            }
            index = (index + 1) % self.cap;
        }
        return ptrLoad(self.valsPtr, 0);
    }

    func contains(k: K) -> Bool {
        if self.cap == 0 { return false; }
        var index = hash(k) % self.cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        while true {
            let state = ptrLoad(self.statesPtr, index * 8);
            if state == 0 {
                return false;
            }
            if state == 1 {
                let current_k = ptrLoad(self.keysPtr, index * 8);
                if current_k == k {
                    return true;
                }
            }
            index = (index + 1) % self.cap;
        }
        return false;
    }

    func keys() -> List<K> {
        let list = List<K>();
        var i = 0;
        while i < self.cap {
            if ptrLoad(self.statesPtr, i * 8) == 1 {
                list.add(ptrLoad(self.keysPtr, i * 8));
            }
            i = i + 1;
        }
        return list;
    }

    func values() -> List<V> {
        let list = List<V>();
        var i = 0;
        while i < self.cap {
            if ptrLoad(self.statesPtr, i * 8) == 1 {
                list.add(ptrLoad(self.valsPtr, i * 8));
            }
            i = i + 1;
        }
        return list;
    }

    func clear() {
        var i = 0;
        while i < self.cap {
            if ptrLoad(self.statesPtr, i * 8) == 1 {
                __pace_release_generic<K>(ptrLoad(self.keysPtr, i * 8));
                __pace_release_generic<V>(ptrLoad(self.valsPtr, i * 8));
            }
            ptrStore(self.statesPtr, i * 8, 0);
            i = i + 1;
        }
        self.count = 0;
    }

    func length() -> Int {
        return self.count;
    }

    func drop() {
        if self.cap != 0 {
            self.clear();
            free(self.keysPtr, self.cap * 8);
            free(self.valsPtr, self.cap * 8);
            free(self.statesPtr, self.cap * 8);
            self.cap = 0;
        }
    }
}
