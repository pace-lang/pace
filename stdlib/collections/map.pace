import "./list";
import "../string-builder";
import "pace:core/iterator";

class Map<K, V> implement Iterable<K> {
    // True Hash-based Map Implementation with Linear Probing
    var _keysPtr: Int;
    var _valsPtr: Int;
    var _statesPtr: Int;
    var _count: Int;
    var _cap: Int;

    func init() {
        self._cap = 16;
        self._count = 0;
        self._keysPtr = malloc(self._cap * 8);
        self._valsPtr = malloc(self._cap * 8);
        self._statesPtr = malloc(self._cap * 8);

        var i = 0;
        while i < self._cap {
            ptrStore(self._statesPtr, i * 8, 0);
            i = i + 1;
        }
    }

    func _resize() {
        let oldCap = self._cap;
        let oldKeys = self._keysPtr;
        let oldVals = self._valsPtr;
        let oldStates = self._statesPtr;

        self._cap = self._cap * 2;
        self._keysPtr = malloc(self._cap * 8);
        self._valsPtr = malloc(self._cap * 8);
        self._statesPtr = malloc(self._cap * 8);

        var i = 0;
        while i < self._cap {
            ptrStore(self._statesPtr, i * 8, 0);
            i = i + 1;
        }

        i = 0;
        while i < oldCap {
            if ptrLoad(oldStates, i * 8) == 1 {
                let k = ptrLoad(oldKeys, i * 8);
                let v = ptrLoad(oldVals, i * 8);
                var index = hash(k) % self._cap;
                if index < 0 {
                    index = index * (0 - 1);
                }
                while ptrLoad(self._statesPtr, index * 8) == 1 {
                    index = (index + 1) % self._cap;
                }
                ptrStore(self._keysPtr, index * 8, k);
                ptrStore(self._valsPtr, index * 8, v);
                ptrStore(self._statesPtr, index * 8, 1);
            }
            i = i + 1;
        }

        free(oldKeys, oldCap * 8);
        free(oldVals, oldCap * 8);
        free(oldStates, oldCap * 8);
    }

    func set(key: K, val: V) {
        if self._count * 2 >= self._cap {
            self._resize();
        }

        var index = hash(key) % self._cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        var firstDeleted = 0 - 1;

        while true {
            let state = ptrLoad(self._statesPtr, index * 8);
            if state == 0 {
                // Empty slot found
                var targetIdx = index;
                if firstDeleted != 0 - 1 {
                    targetIdx = firstDeleted;
                }
                __pace_retain_generic<K>(key);
                __pace_retain_generic<V>(val);
                ptrStore(self._keysPtr, targetIdx * 8, key);
                ptrStore(self._valsPtr, targetIdx * 8, val);
                ptrStore(self._statesPtr, targetIdx * 8, 1);
                self._count = self._count + 1;
                return;
            }
            if state == 1 {
                let k = ptrLoad(self._keysPtr, index * 8);
                if k == key {
                    // Overwrite existing
                    let _oldVal = ptrLoad(self._valsPtr, index * 8);
                    __pace_release_generic<V>(_oldVal);
                    __pace_retain_generic<V>(val);
                    ptrStore(self._valsPtr, index * 8, val);
                    return;
                }
            }
            if state == 2 {
                if firstDeleted == 0 - 1 {
                    firstDeleted = index;
                }
            }
            index = (index + 1) % self._cap;
        }
    }

    func addAll(other: Map<K, V>) {
        let keys = other.keys();
        var i = 0;
        let l = keys.length();
        while i < l {
            let k = keys.get(i);
            self.set(k, other.get(k));
            i = i + 1;
        }
    }

    func remove(key: K) -> Bool {
        if self._cap == 0 { return false; }
        var index = hash(key) % self._cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        while true {
            let state = ptrLoad(self._statesPtr, index * 8);
            if state == 0 {
                return false;
            }
            if state == 1 {
                let k = ptrLoad(self._keysPtr, index * 8);
                if k == key {
                    ptrStore(self._statesPtr, index * 8, 2); // Mark deleted
                    __pace_release_generic<K>(ptrLoad(self._keysPtr, index * 8));
                    __pace_release_generic<V>(ptrLoad(self._valsPtr, index * 8));
                    self._count = self._count - 1;
                    return true;
                }
            }
            index = (index + 1) % self._cap;
        }
        return false;
    }

    func get(k: K) -> V {
        if self._cap == 0 {
            return ptrLoad(self._valsPtr, 0); // Null/default fallback
        }
        var index = hash(k) % self._cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        while true {
            let state = ptrLoad(self._statesPtr, index * 8);
            if state == 0 {
                return ptrLoad(self._valsPtr, 0); // Null/default fallback
            }
            if state == 1 {
                let currentK = ptrLoad(self._keysPtr, index * 8);
                if currentK == k {
                    return ptrLoad(self._valsPtr, index * 8);
                }
            }
            index = (index + 1) % self._cap;
        }
        return ptrLoad(self._valsPtr, 0);
    }

    func containsKey(k: K) -> Bool {
        if self._cap == 0 { return false; }
        var index = hash(k) % self._cap;
        if index < 0 {
            index = index * (0 - 1);
        }

        while true {
            let state = ptrLoad(self._statesPtr, index * 8);
            if state == 0 {
                return false;
            }
            if state == 1 {
                let currentK = ptrLoad(self._keysPtr, index * 8);
                if currentK == k {
                    return true;
                }
            }
            index = (index + 1) % self._cap;
        }
        return false;
    }

    func keys() -> List<K> {
        let list = List<K>();
        var i = 0;
        while i < self._cap {
            if ptrLoad(self._statesPtr, i * 8) == 1 {
                list.add(ptrLoad(self._keysPtr, i * 8));
            }
            i = i + 1;
        }
        return list;
    }

    func values() -> List<V> {
        let list = List<V>();
        var i = 0;
        while i < self._cap {
            if ptrLoad(self._statesPtr, i * 8) == 1 {
                list.add(ptrLoad(self._valsPtr, i * 8));
            }
            i = i + 1;
        }
        return list;
    }

    func clear() {
        var i = 0;
        while i < self._cap {
            if ptrLoad(self._statesPtr, i * 8) == 1 {
                __pace_release_generic<K>(ptrLoad(self._keysPtr, i * 8));
                __pace_release_generic<V>(ptrLoad(self._valsPtr, i * 8));
            }
            ptrStore(self._statesPtr, i * 8, 0);
            i = i + 1;
        }
        self._count = 0;
    }

    func length() -> Int {
        return self._count;
    }

    func isEmpty() -> Bool {
        return self._count == 0;
    }

    func isNotEmpty() -> Bool {
        return self._count > 0;
    }

    func containsValue(v: V) -> Bool {
        if self._cap == 0 { return false; }
        var i = 0;
        while i < self._cap {
            if ptrLoad(self._statesPtr, i * 8) == 1 {
                let currentV = ptrLoad(self._valsPtr, i * 8);
                if currentV == v {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    func getKey(index: Int) -> K {
        return ptrLoad(self._keysPtr, index * 8);
    }

    func getCap() -> Int {
        return self._cap;
    }

    func getStatesPtr() -> Int {
        return self._statesPtr;
    }

    func _getVal(index: Int) -> V {
        return ptrLoad(self._valsPtr, index * 8);
    }

    func iterator() -> Iterator<K> {
        return MapKeyIterator<K, V>(self);
    }

    func toString() -> String {
        let sb = StringBuilder();
        sb.init();
        sb.append("{");
        var first = true;
        var i = 0;
        while i < self._cap {
            if ptrLoad(self._statesPtr, i * 8) == 1 {
                if first == false {
                    sb.append(", ");
                }
                first = false;
                let k = self.getKey(i);
                let v = self._getVal(i);
                sb.append(k.toString());
                sb.append(": ");
                sb.append(v.toString());
            }
            i = i + 1;
        }
        sb.append("}");
        return sb.build();
    }

    func drop() {
        if self._cap != 0 {
            self.clear();
            free(self._keysPtr, self._cap * 8);
            free(self._valsPtr, self._cap * 8);
            free(self._statesPtr, self._cap * 8);
            self._cap = 0;
        }
    }
}

class MapKeyIterator<K, V> implement Iterator<K> {
    var map: Map<K, V>;
    var idx: Int;

    func init(map: Map<K, V>) {
        self.map = map;
        self.idx = 0;
        self._advanceToValid();
    }

    func _advanceToValid() {
        while self.idx < self.map.getCap() {
            if ptrLoad(self.map.getStatesPtr(), self.idx * 8) == 1 {
                return;
            }
            self.idx = self.idx + 1;
        }
    }

    func hasNext() -> Bool {
        return self.idx < self.map.getCap();
    }

    func next() -> K {
        let val = self.map.getKey(self.idx);
        self.idx = self.idx + 1;
        self._advanceToValid();
        return val;
    }
}
