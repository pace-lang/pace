import "./list";
class MapEntry<K, V> {
    var key: K;
    var value: V;

    func init(k: K, v: V) {
        self.key = k;
        self.value = v;
    }

}

class Map<K, V> implement Iterable<K> {
    // True Hash-based Map Implementation
    var buckets: List<List<MapEntry<K, V>>>;
    var count: Int;

    func init() {
        self.buckets = List<List<MapEntry<K, V>>>();
        self.count = 0;
        var i = 0;
        let capacity = 65536; // Initial capacity
        while i < capacity {
            self.buckets.add(List<MapEntry<K, V>>());
            i = i + 1;
        }
    }

    func put(key: K, val: V) {
        var index = hash(key) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        let bucket = self.buckets.get(index);
        var i = 0;
        let len = bucket.length();
        while i < len {
            let entry = bucket.get(i);
            if entry.key == key {
                entry.value = val;
                return;
            }
            i = i + 1;
        }
        // Key not found, append a new entry
        let entry = MapEntry<K, V>(key, val);
        bucket.add(entry);
        self.count = self.count + 1;
    }

    func putAll(other: Map<K, V>) {
        let keys = other.keys();
        var i = 0;
        let l = keys.length();
        while i < l {
            let k = keys.get(i);
            self.put(k, other.get(k));
            i = i + 1;
        }
    }

    func remove(key: K) -> Bool {
        var index = hash(key) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        let bucket = self.buckets.get(index);
        var i = 0;
        let len = bucket.length();
        while i < len {
            if bucket.get(i).key == key {
                bucket.remove(i);
                self.count = self.count - 1;
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    func get(k: K) -> V {
        var index = hash(k) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        let bucket = self.buckets.get(index);
        var i = 0;
        let len = bucket.length();
        while i < len {
            let entry = bucket.get(i);
            if entry.key == k {
                return entry.value;
            }
            i = i + 1;
        }
        return bucket.get(0).value;
    }

    // Assuming key exists for now
    func contains(k: K) -> Bool {
        var index = hash(k) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        let bucket = self.buckets.get(index);
        var i = 0;
        let len = bucket.length();
        while i < len {
            if bucket.get(i).key == k {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    func keys() -> List<K> {
        let list = List<K>();
        var i = 0;
        let numBuckets = self.buckets.length();
        while i < numBuckets {
            let bucket = self.buckets.get(i);
            var j = 0;
            let bucketLen = bucket.length();
            while j < bucketLen {
                list.add(bucket.get(j).key);
                j = j + 1;
            }
            i = i + 1;
        }
        return list;
    }

    func values() -> List<V> {
        let list = List<V>();
        var i = 0;
        let numBuckets = self.buckets.length();
        while i < numBuckets {
            let bucket = self.buckets.get(i);
            var j = 0;
            let bucketLen = bucket.length();
            while j < bucketLen {
                list.add(bucket.get(j).value);
                j = j + 1;
            }
            i = i + 1;
        }
        return list;
    }

    func clear() {
        var i = 0;
        let capacity = 65536;
        while i < capacity {
            self.buckets.get(i).clear();
            i = i + 1;
        }
        self.count = 0;
    }

    func length() -> Int {
        return self.count;
    }

}

