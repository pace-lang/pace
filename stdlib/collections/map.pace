import "./list";

class MapEntry<K, V> {
    var key: K;
    var value: V;
    
    func init(k: K, v: V) {
        self.key = k;
        self.value = v;
    }
}

// True Hash-based Map Implementation
class Map<K, V> implement Iterable<K> {
    var buckets: List<List<MapEntry<K, V>>>;
    var count: Int;

    func init() {
        self.buckets = List<List<MapEntry<K, V>>>();
        self.count = 0;
        
        var i = 0;
        let capacity = 65536; // Initial capacity
        while i < capacity {
            self.buckets.push(List<MapEntry<K, V>>());
            i = i + 1;
        }
    }

    func set(key: K, val: V) {
        var index = hash(key) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        
        let bucket = self.buckets.get(index);
        
        var i = 0;
        let len = bucket.length();
        while i < len {
            let entry = bucket.get(i);
            if entry.key == key {
                entry.value = val;
                return;
            }
            i = i + 1;
        }
        
        // Key not found, append a new entry
        let entry = MapEntry<K, V>(key, val);
        bucket.push(entry);
        self.count = self.count + 1;
    }

    func get(k: K) -> V {
        var index = hash(k) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        
        let bucket = self.buckets.get(index);
        
        var i = 0;
        let len = bucket.length();
        while i < len {
            let entry = bucket.get(i);
            if entry.key == k {
                return entry.value;
            }
            i = i + 1;
        }
        
        // Assuming key exists for now
        return bucket.get(0).value; 
    }

    func contains(k: K) -> Bool {
        var index = hash(k) % self.buckets.length();
        if index < 0 {
            index = index * (0 - 1);
        }
        
        let bucket = self.buckets.get(index);
        
        var i = 0;
        let len = bucket.length();
        while i < len {
            if bucket.get(i).key == k {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    
    func length() -> Int {
        return self.count;
    }
}
