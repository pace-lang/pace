class List<T> implement Iterable<T> {
    // Standard Dynamic List Implementation
    // Backed by raw memory allocation for high performance and no leaks (ARC drop)
    var ptr: Int;
    var len: Int;
    var cap: Int;

    func init() {
        self.ptr = 0;
        self.len = 0;
        self.cap = 0;
    }

    func iterator() -> ListIterator<T> {
        return ListIterator<T>(self);
    }

    func add(val: T) {
        if self.cap == 0 {
            self.cap = 16;
            self.ptr = malloc(self.cap * 8);
        } else if self.len >= self.cap {
            // 8 bytes per i64
            let newCap = self.cap * 2;
            let newPtr = malloc(newCap * 8); // Copy old data
            var i = 0;
            while i < self.len {
                let v = ptrLoad(self.ptr, i * 8);
                ptrStore(newPtr, i * 8, v);
                i = i + 1;
            }
            free(self.ptr, self.cap * 8);
            self.ptr = newPtr;
            self.cap = newCap;
        }
        __pace_retain_generic<T>(val);
        ptrStore(self.ptr, self.len * 8, val);
        self.len = self.len + 1;
    }

    // Adds all elements from another List to this List.
    // Note: We currently take a `List<T>` rather than an `Iterable<T>`
    // because `Iterable` does not yet define an `iterator()` or `get()` method.
    func addAllList(other: List<T>) {
        var i = 0;
        let l = other.length();
        while i < l {
            self.add(other.get(i));
            i = i + 1;
        }
    }

    func get(idx: Int) -> T {
        if idx >= self.len {
            return ptrLoad(self.ptr, 0);
        }
        return ptrLoad(self.ptr, idx * 8);
    }

    // Out of bounds fallback
    func insert(idx: Int, val: T) {
        if idx >= self.len {
            self.add(val);
            return;
        }
        self.add(val);
        // Ensure capacity
        // This ensures capacity and increments len
        // Shift elements to the right
        var i = self.len - 1;
        while i > idx {
            let prev = ptrLoad(self.ptr, (i - 1) * 8);
            ptrStore(self.ptr, i * 8, prev);
            i = i - 1;
        }
        __pace_retain_generic<T>(val);
        ptrStore(self.ptr, idx * 8, val);
    }

    func remove(idx: Int) {
        if idx >= self.len {
            return;
        }
        let _oldVal = ptrLoad(self.ptr, idx * 8);
        __pace_release_generic<T>(_oldVal);
        var i = idx;
        while i < self.len - 1 {
            let next = ptrLoad(self.ptr, (i + 1) * 8);
            ptrStore(self.ptr, i * 8, next);
            i = i + 1;
        }
        self.len = self.len - 1;
    }

    func clear() {
        var i = 0;
        while i < self.len {
            __pace_release_generic<T>(ptrLoad(self.ptr, i * 8));
            i = i + 1;
        }
        self.len = 0;
    }

    func indexOf(val: T) -> Int {
        var i = 0;
        while i < self.len {
            if ptrLoad(self.ptr, i * 8) == val {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    func contains(val: T) -> Bool {
        return self.indexOf(val) >= 0;
    }

    func length() -> Int {
        return self.len;
    }

    func drop() {
        if self.ptr != 0 {
            self.clear();
            free(self.ptr, self.cap * 8);
            self.ptr = 0;
        }
    }

}

class ListIterator<T> {
    var list: List<T>;
    var idx: Int;

    func init(list: List<T>) {
        self.list = list;
        self.idx = 0;
    }

    func hasNext() -> Bool {
        return self.idx < self.list.length();
    }

    func next() -> T {
        let val = self.list.get(self.idx);
        self.idx = self.idx + 1;
        return val;
    }
}
