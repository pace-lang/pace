import "../string-builder";
import "pace:core/iterator";

class List<T> implement Iterable<T> {
    // Backed by raw memory allocation for high performance and no leaks (ARC drop)
    var _ptr: Int;
    var _len: Int;
    var _cap: Int;

    func init() {
        self._ptr = 0;
        self._len = 0;
        self._cap = 0;
    }

    func iterator() -> ListIterator<T> {
        return ListIterator<T>(self);
    }

    func add(val: T) {
        if self._cap == 0 {
            self._cap = 16;
            self._ptr = malloc(self._cap * 8);
        } else if self._len >= self._cap {
            // 8 bytes per i64
            let newCap = self._cap * 2;
            let newPtr = malloc(newCap * 8); // Copy old data
            var i = 0;
            while i < self._len {
                let v = ptrLoad(self._ptr, i * 8);
                ptrStore(newPtr, i * 8, v);
                i = i + 1;
            }
            free(self._ptr, self._cap * 8);
            self._ptr = newPtr;
            self._cap = newCap;
        }
        __pace_retain_generic<T>(val);
        ptrStore(self._ptr, self._len * 8, val);
        self._len = self._len + 1;
    }

    // Adds all elements from another Iterable to this List.
    func addAll(other: Iterable<T>) {
        let it = other.iterator();
        while it.hasNext() {
            self.add(it.next());
        }
    }

    func get(idx: Int) -> T {
        if idx >= self._len {
            return ptrLoad(self._ptr, 0);
        }
        return ptrLoad(self._ptr, idx * 8);
    }

    // Out of bounds fallback
    func insert(idx: Int, val: T) {
        if idx >= self._len {
            self.add(val);
            return;
        }
        self.add(val);
        // Ensure capacity
        // This ensures capacity and increments len
        // Shift elements to the right
        var i = self._len - 1;
        while i > idx {
            let prev = ptrLoad(self._ptr, (i - 1) * 8);
            ptrStore(self._ptr, i * 8, prev);
            i = i - 1;
        }
        __pace_retain_generic<T>(val);
        ptrStore(self._ptr, idx * 8, val);
    }

    func removeAt(idx: Int) -> T {
        if idx >= self._len {
            return ptrLoad(self._ptr, 0); // fallback
        }
        let _oldVal = ptrLoad(self._ptr, idx * 8);
        var i = idx;
        while i < self._len - 1 {
            let next = ptrLoad(self._ptr, (i + 1) * 8);
            ptrStore(self._ptr, i * 8, next);
            i = i + 1;
        }
        self._len = self._len - 1;
        return _oldVal;
    }

    func remove(val: T) -> Bool {
        let idx = self.indexOf(val);
        if idx >= 0 {
            let removed = self.removeAt(idx);
            __pace_release_generic<T>(removed);
            return true;
        }
        return false;
    }

    func removeLast() -> T {
        return self.removeAt(self._len - 1);
    }

    func clear() {
        var i = 0;
        while i < self._len {
            __pace_release_generic<T>(ptrLoad(self._ptr, i * 8));
            i = i + 1;
        }
        self._len = 0;
    }

    func indexOf(val: T) -> Int {
        var i = 0;
        while i < self._len {
            if ptrLoad(self._ptr, i * 8) == val {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    func contains(val: T) -> Bool {
        return self.indexOf(val) >= 0;
    }

    func length() -> Int {
        return self._len;
    }

    func isEmpty() -> Bool {
        return self._len == 0;
    }

    func isNotEmpty() -> Bool {
        return self._len > 0;
    }

    func first() -> T {
        return self.get(0);
    }

    func last() -> T {
        if self._len == 0 {
            return self.get(0);
        }
        return self.get(self._len - 1);
    }

    func toString() -> String {
        let sb = StringBuilder();
        sb.init();
        sb.append("[");
        var i = 0;
        while i < self._len {
            sb.append(self.get(i).toString());
            if i < self._len - 1 {
                sb.append(", ");
            }
            i = i + 1;
        }
        sb.append("]");
        return sb.build();
    }

    func drop() {
        if self._ptr != 0 {
            self.clear();
            free(self._ptr, self._cap * 8);
            self._ptr = 0;
        }
    }

}

class ListIterator<T> implement Iterator<T> {
    var list: List<T>;
    var idx: Int;

    func init(list: List<T>) {
        self.list = list;
        self.idx = 0;
    }

    func hasNext() -> Bool {
        return self.idx < self.list.length();
    }

    func next() -> T {
        let val = self.list.get(self.idx);
        self.idx = self.idx + 1;
        return val;
    }
}
