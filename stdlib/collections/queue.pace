class Queue<T> implement Iterable<T> {
    // Standard Dynamic Queue Implementation
    // Backed by raw memory allocation for high performance and no leaks (ARC drop)
    var ptr: Int;
    var head: Int;
    var tail: Int;
    var cap: Int;

    func init() {
        self.ptr = 0;
        self.head = 0;
        self.tail = 0;
        self.cap = 0;
    }

    func enqueue(val: T) {
        if self.cap == 0 {
            self.cap = 16;
            self.ptr = malloc(self.cap * 8);
        } else if self.tail >= self.cap {
            // 8 bytes per i64
            // For simplicity, we just reallocate instead of ring buffer for now
            let newCap = self.cap * 2;
            let newPtr = malloc(newCap * 8); // Copy old data
            var i = self.head;
            var j = 0;
            while i < self.tail {
                let v = ptrLoad(self.ptr, i * 8);
                ptrStore(newPtr, j * 8, v);
                i = i + 1;
                j = j + 1;
            }
            free(self.ptr, self.cap * 8);
            self.ptr = newPtr;
            self.cap = newCap;
            self.head = 0;
            self.tail = j;
        }
        ptrStore(self.ptr, self.tail * 8, val);
        self.tail = self.tail + 1;
    }

    func dequeue() -> T {
        if self.head >= self.tail {
            return ptrLoad(self.ptr, 0);
        }
        // Empty queue
        let v = ptrLoad(self.ptr, self.head * 8);
        self.head = self.head + 1;
        if self.head == self.tail {
            self.head = 0;
            self.tail = 0;
        }
        return v;
    }

    // Reset if empty to save space
    func length() -> Int {
        return self.tail - self.head;
    }

    func drop() {
        if self.ptr != 0 {
            free(self.ptr, self.cap * 8);
            self.ptr = 0;
        }
    }

}

