// Core Array Implementation
// Backed by raw memory allocation for high performance and no leaks (ARC drop)

class IntArray {
    var ptr: Int;
    var len: Int;
    var cap: Int;

    func init() {
        self.ptr = 0;
        self.len = 0;
        self.cap = 0;
    }

    func push(val: Int) {
        if self.ptr == 0 {
            self.cap = 100;
            self.ptr = malloc(self.cap * 8); // 8 bytes per i64
        }
        ptrStore(self.ptr, self.len * 8, val);
        self.len = self.len + 1;
    }

    func get(idx: Int) -> Int {
        if idx >= self.len {
            // Out of bounds, ideally panic here
            return 0;
        }
        return ptrLoad(self.ptr, idx * 8);
    }

    func drop() {
        if self.ptr != 0 {
            free(self.ptr, self.cap * 8);
            self.ptr = 0;
        }
    }
}
