import "./tree-map";
import "./list";
import "../string-builder";
import "pace:core/iterator";

class TreeSet<T> implement Iterable<T> {
    // A TreeSet stores elements in sorted order.
    // Uses a TreeMap internally for O(log N) (on average) deduplication and ordered iteration
    var _map: TreeMap<T, Bool>;

    func init() {
        self._map = TreeMap<T, Bool>();
        self._map.init();
    }

    func add(val: T) {
        self._map.set(val, true);
    }

    func contains(val: T) -> Bool {
        return self._map.containsKey(val);
    }

    func length() -> Int {
        return self._map.length();
    }

    func isEmpty() -> Bool {
        return self._map.isEmpty();
    }

    func getList() -> List<T> {
        return self._map.keys();
    }

    func toString() -> String {
        let sb = StringBuilder();
        sb.init();
        sb.append("[");
        let keys = self._map.keys();
        var i = 0;
        while i < keys.length() {
            sb.append(keys.get(i).toString());
            if i < keys.length() - 1 {
                sb.append(", ");
            }
            i = i + 1;
        }
        sb.append("]");
        return sb.build();
    }

    func iterator() -> Iterator<T> {
        return TreeSetIterator<T>(self);
    }
}

class TreeSetIterator<T> implement Iterator<T> {
    var set: TreeSet<T>;
    var listIterator: Iterator<T>;

    func init(set: TreeSet<T>) {
        self.set = set;
        self.listIterator = set.getList().iterator();
    }

    func hasNext() -> Bool {
        return self.listIterator.hasNext();
    }

    func next() -> T {
        return self.listIterator.next();
    }
}
