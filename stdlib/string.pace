import "./collections/list";
export "./string-builder";
class StringUtil {
    // String utilities
    static func split(s: String, delim: String) -> List<String> {
        let ptr = stringSplit(s, delim);
        let len: Int = ptrLoad(ptr, 0);
        let list = List<String>();
        var i = 0;
        while i < len {
            let offset = (i + 1) * 8;
            let str: String = ptrLoad(ptr, offset);
            list.add(str);
            i = i + 1;
        }
        free(ptr, (len + 1) * 8);
        return list;
    }

    static func replace(s: String, old: String, newStr: String) -> String {
        return stringReplace(s, old, newStr);
    }

    static func substring(s: String, start: Int, end: Int) -> String {
        return stringSubstring(s, start, end);
    }

    static func trim(s: String) -> String {
        return stringTrim(s);
    }

    static func indexOf(s: String, search: String) -> Int {
        return stringIndexOf(s, search);
    }

    static func startsWith(s: String, search: String) -> Bool {
        return stringStartsWith(s, search) != 0;
    }

    static func join(list: List<String>, delim: String) -> String {
        let sb = StringBuilder();
        var i = 0;
        let len = list.length();
        while i < len {
            sb.append(list.get(i));
            if i < len - 1 {
                sb.append(delim);
            }
            i = i + 1;
        }
        let res = sb.build();
        sb.free();
        return res;
    }

}

