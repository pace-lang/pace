class StringBuilder {
    var ptr: Int;

    func init() {
        self.ptr = sbNew();
    }

    func append(s: String) {
        sbAppend(self.ptr, s);
    }

    func build() -> String {
        return sbBuild(self.ptr);
    }

    func free() {
        sbFree(self.ptr);
        self.ptr = 0;
    }
}
