import "./string";

extern func __pace_malloc(size: Int) -> Int;
extern func __pace_free(ptr: Int, size: Int);
extern func __pace_ptr_load8(ptr: Int, offset: Int) -> Int;
extern func __pace_ptr_store8(ptr: Int, offset: Int, val: Int);
extern func __pace_string_to_ptr(s: String) -> Int;
extern func __pace_ptr_to_string(ptr: Int) -> String;
extern func __pace_realloc(ptr: Int, old_size: Int, new_size: Int) -> Int;
extern func __pace_memcpy(dst: Int, src: Int, size: Int);

class StringBuilder {
    var buffer: Int;
    var capacity: Int;
    var length: Int;

    func init() {
        self.capacity = 16;
        self.length = 0;
        self.buffer = __pace_malloc(self.capacity);
    }

    func stringLength(s: String) -> Int {
        let ptr = __pace_string_to_ptr(s);
        var len = 0;
        var shouldLoop = true;
        while shouldLoop {
            let ch = __pace_ptr_load8(ptr, len);
            if ch == 0 {
                shouldLoop = false;
            } else {
                len = len + 1;
            }
        }
        return len;
    }

    func append(s: String) {
        let sLen = self.stringLength(s);
        let sPtr = __pace_string_to_ptr(s);
        
        let newLen = self.length + sLen;
        if newLen >= self.capacity {
            // Reallocate
            var newCap = self.capacity * 2;
            while newCap <= newLen {
                newCap = newCap * 2;
            }
            self.buffer = __pace_realloc(self.buffer, self.capacity, newCap);
            self.capacity = newCap;
        }

        // Copy new string
        __pace_memcpy(self.buffer + self.length, sPtr, sLen);
        self.length = newLen;
    }

    func build() -> String {
        let resPtr = __pace_malloc(self.length + 1);
        __pace_memcpy(resPtr, self.buffer, self.length);
        __pace_ptr_store8(resPtr, self.length, 0);
        return __pace_ptr_to_string(resPtr);
    }

    func free() {
        if self.buffer != 0 {
            __pace_free(self.buffer, self.capacity);
            self.buffer = 0;
        }
    }
}
