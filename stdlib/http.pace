extern func httpGet(url: String) -> String?;
extern func httpPost(url: String, body: String) -> String?;
extern func httpPut(url: String, body: String) -> String?;
extern func httpDelete(url: String) -> String?;
extern func getLastError() -> String;

class Http {
    // HTTP stdlib using native FFI
    static func get(url: String) -> Result<String, String> {
        let ptr = httpGet(url);
        if ptr == null {
            return Result<String, String>::Err(getLastError());
        }
        return Result<String, String>::Ok(ptr);
    }

    static func post(url: String, body: String) -> Result<String, String> {
        let ptr = httpPost(url, body);
        if ptr == null {
            return Result<String, String>::Err(getLastError());
        }
        return Result<String, String>::Ok(ptr);
    }

    static func put(url: String, body: String) -> Result<String, String> {
        let ptr = httpPut(url, body);
        if ptr == null {
            return Result<String, String>::Err(getLastError());
        }
        return Result<String, String>::Ok(ptr);
    }

    static func delete(url: String) -> Result<String, String> {
        let ptr = httpDelete(url);
        if ptr == null {
            return Result<String, String>::Err(getLastError());
        }
        return Result<String, String>::Ok(ptr);
    }

}

