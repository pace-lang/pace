import "../stdlib/src/collections/list.pace" show List, sizeof;

public struct Point {
    public var x: Int;
    public var y: Int;
    public func init(x: Int, y: Int) {
        self.x = x;
        self.y = y;
    }
}

func makePoint(x: Int, y: Int): Point {
    let p = Point(x, y);
    return p;
}

func main() {
    let p = makePoint(5, 10);
    print(p.x);
    print(p.y);
    
    // Testing sizeof
    print(sizeof<Point>());
    
    let arr = List<Point>();
    arr.push(makePoint(1, 2));
    arr.push(makePoint(3, 4));
    print(arr.getUnsafe(0).x);
}
