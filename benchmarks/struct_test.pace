import "../stdlib/src/collections/list.pace" show List, sizeof;

public struct Point {
    public var padding: Int;
    public var x: Int;
    public var y: Int;
    
    public func init(padding: Int, x: Int, y: Int) {
        self.padding = padding;
        self.x = x;
        self.y = y;
    }
}





func main() {
    let p = Point(0, 5, 10);
    print(p.x);
    print(p.y);
    
    // Testing sizeof
    print(sizeof<Point>());
    let ptr = malloc(24);
    ptrWrite<Point>(ptr, 0, Point(100, 200, 300));
    let p2 = ptrRead<Point>(ptr, 0);
    print(p2.x);
    print(p2.y);
    
    let p_test = Point(999, -5, 2000);
    print(p_test.padding);
    print(p_test.x);
    print(p_test.y);
    
    let opt = Option.Some(p_test);
    let p3 = opt.unwrap();
    print(p3.x);
    print(p3.y);
    
    let arr = List<Point>();
    arr.push(Point(0, 10, 20));
    arr.push(Point(0, 30, 40));
    print(arr.get(0).unwrap().padding);
    print(arr.get(0).unwrap().x);
    print(arr.get(0).unwrap().y);
    print(arr.get(1).unwrap().x);
    print(arr.get(1).unwrap().y);
}
