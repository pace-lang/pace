import "pace:collections";
func map_test() -> Int {
    let map = Map<Int, Int>();
    var i = 0;
    while i < 10000 {
        map.put(i, i * 2);
        i = i + 1;
    }
    var sum = 0;
    i = 0;
    while i < 10000 {
        sum = sum + map.get(i);
        i = i + 1;
    }
    return sum;
}

func main() {
    print(map_test());
}

