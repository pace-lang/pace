import "../../stdlib/src/json/parser.pace";
import "../../stdlib/src/core/string.pace";
import "../../stdlib/src/core/array.pace";

func main() {
    let source = "{\"user\":{\"id\":42,\"name\":\"Aniket\",\"active\":true,\"balance\":1250.75,\"email\":null,\"roles\":[\"developer\",\"maintainer\"],\"profile\":{\"age\":22,\"verified\":true,\"skills\":[{\"name\":\"Rust\",\"level\":4},{\"name\":\"Dart\",\"level\":5}]}},\"projects\":[{\"name\":\"Pace\",\"version\":0.3,\"open_source\":true},{\"name\":\"Hadron\",\"version\":1.0,\"open_source\":false}]}";
    
    var i = 0;
    while i < 10000 {
        let result = parseJson(source);
        if result.isErr() {
            print("Error parsing");
            return;
        }
        i = i + 1;
    }
    print("Parsed 10000 times");
}
