import "../../stdlib/src/net/http.pace";
import "../../stdlib/src/core/string.pace";

func main() {
    let url = "https://jsonplaceholder.typicode.com/todos/1";
    
    // We will do a single request for the benchmark because HTTP requests are inherently slow
    // But we'll do it a few times to show average response.
    
    let iterations = 10;
    var successCount = 0;
    
    let client = HttpClient(HttpClientOptions(30, "pace-benchmark"));
    
    var i = 0;
    while i < iterations {
        let req = HttpRequest("GET", url);
        let result = client.send(req);
        if result.isOk() {
            let resp = result.unwrap();
            if resp.status == 200 {
                successCount = successCount + 1;
            }
        }
        i = i + 1;
    }
    
    client.close();
    
    if successCount == iterations {
        // success!
    } else {
        // failed
    }
}
