import "../../stdlib/src/net/http.pace";
import "../../stdlib/src/core/string.pace";

func handleReq(req: HttpRequest) {
    if req.path == "/json" {
        let resp = HttpServerResponse(HttpStatus.StatusOk().toInt(), "{\"status\": \"ok\", \"language\": \"pace\"}");
        resp.setJson("{\"status\": \"ok\", \"language\": \"pace\"}");
        req.respondWith(resp);
    } else {
        let resp = HttpServerResponse(HttpStatus.StatusOk().toInt(), "Hello from Pace Server!");
        resp.addHeader("Content-Type", "text/plain");
        req.respondWith(resp);
    }
}

func main() {
    let server = bindHttpServer("127.0.0.1:3000");
    print("Pace HTTP server listening on http://127.0.0.1:3000");
    
    while true {
        let req = server.accept();
        if req.isValid {
            handleReq(req);
        } else {
            req.stream.close();
        }
    }
}
