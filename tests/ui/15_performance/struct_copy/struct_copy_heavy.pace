struct Node {
    var val: Int;
    var a: Int;
    var b: Int;
    var c: Int;
    
    func init(val: Int, a: Int, b: Int, c: Int) {
        self.val = val;
        self.a = a;
        self.b = b;
        self.c = c;
    }
}

func main() {
    var original = Node(0, 1, 2, 3);
    var i = 0;
    
    while i < 1000000 {
        // Deep copy struct 1 million times
        var copy1 = original;
        var copy2 = copy1;
        var copy3 = copy2;
        copy3.val = i;
        i = i + 1;
    }
    
    printStr("Finished struct copies.");
}
