func sieve(limit: Int): Int {
    var primes = Map<Int, Boolean>();
    
    var i = 2;
    while i <= limit {
        primes.set(i, true);
        i = i + 1;
    }
    
    var p = 2;
    while p * p <= limit {
        var isPrime = primes.get(p);
        if isPrime.unwrapOr(false) {
            var i = p * p;
            while i <= limit {
                primes.set(i, false);
                i = i + p;
            }
        }
        p = p + 1;
    }
    
    var count = 0;
    var i2 = 2;
    while i2 <= limit {
        var isP = primes.get(i2);
        if isP.unwrapOr(false) {
            count = count + 1;
        }
        i2 = i2 + 1;
    }
    return count;
}

func main() {
    printStr("Calculating primes up to 100,000...");
    let numPrimes = sieve(100000);
    printStr("Number of primes found:");
    print(numPrimes);
}
