actor Counter {
    count: Int;

    func init() {
        self.count = 0;
    }

    func increment() {
        self.count = self.count + 1;
    }

    func getCount(): Int {
        return self.count;
    }
}

func main() {
    print("Creating actor");
    final c := Counter();
    print("Sending increment");
    c.increment();
    c.increment();
    print("Getting count");
    final result := c.getCount();
    // Getting count doesn't actually block here since we don't have await in main, but it's just a syntax/lowering test for now
    // print(result); // Removing this line because it prints a memory address which changes every run and breaks snapshot testing
}
