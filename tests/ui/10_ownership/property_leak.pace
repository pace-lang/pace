class Child {
    id: Int;
}

class Parent {
    child: Child;
}

func main() {
    final p := Parent();
    final c := Child();
    p.child = c;
    // When main exits, p goes out of scope and is released.
    // The runtime should iterate p's properties and release c.
    // If it works correctly, we should see "Freeing object memory" twice.
}
