struct Point {
    x: Int;
    y: Int;
    func init(x: Int, y: Int) {
        self.x = x;
        self.y = y;
    }
}

struct Rect {
    topLeft: Point;
    bottomRight: Point;
    func init(topLeft: Point, bottomRight: Point) {
        self.topLeft = topLeft;
        self.bottomRight = bottomRight;
    }
}

func main() {
    p1 := Point(10, 20);
    p2 := p1;
    
    // Modifying p2 should NOT modify p1
    p2.x = 100;
    p2.y = 200;
    
    print("Point p1:");
    print(p1.x);
    print(p1.y);
    
    print("Point p2:");
    print(p2.x);
    print(p2.y);
    
    let r1 = Rect { topLeft: Point { x: 5, y: 5 }, bottomRight: Point { x: 15, y: 15 } };
    let r2 = r1; // deep copy
    
    r1.topLeft.x = 99;
    
    print("Rect1 topLeft.x:");
    print(r1.topLeft.x);
    
    print("Rect2 topLeft.x:");
    print(r2.topLeft.x);
}
