interface Animal {
    func speak();
}

class Dog implements Animal {
    func init() {}
    func speak() {
        print("Woof!");
    }
}

class Cat implements Animal {
    func init() {}
    func speak() {
        print("Meow!");
    }
}

func makeSpeak(animal: Animal) {
    animal.speak();
}

func main(): Int {
    let dog = Dog();
    makeSpeak(dog);
    
    let cat = Cat();
    makeSpeak(cat);
    return 0;
}
