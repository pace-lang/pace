class MyList<T> implements Iterable<T> {
    func iter(): Iterator<T> {
        return MyIterator<T>();
    }
}

class MyIterator<T> implements Iterator<T> {
    func next(): Option<T> {
        let opt: Option<T>;
        return opt;
    }
}

func main() {
    let list = MyList<Int>();
    for item in list {
        print(item);
    }
}
