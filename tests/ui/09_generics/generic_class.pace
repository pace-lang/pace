class Box<T> {
    var value: T;
    
    func init(val: T) {
        self.value = val;
    }
    
    func get() -> T {
        return self.value;
    }
}

class ArrayWrapper<T> {
    var items: [T];
    
    func init(arr: [T]) {
        self.items = arr;
    }
    
    func getFirst() -> T {
        return self.items[0];
    }
}

func main() {
    let intBox = Box(100);
    print(intBox.get());
    
    let arr = [10, 20, 30];
    let wrapper = ArrayWrapper(arr);
    print(wrapper.getFirst());
}
