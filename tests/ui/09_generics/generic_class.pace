class Box<T> {
    value: T;
    
    func init(val: T) {
        self.value = val;
    }
    
    func get(): T {
        return self.value;
    }
}

class ArrayWrapper<T> {
    items: [T];
    
    func init(arr: [T]) {
        self.items = arr;
    }
    
    func getFirst(): T {
        return self.items[0];
    }
}

func main() {
    final intBox := Box(100);
    print(intBox.get());
    
    final arr := [10, 20, 30];
    final wrapper := ArrayWrapper(arr);
    print(wrapper.getFirst());
}
