import "../../../stdlib/src/collections/list.pace";
import "../../../stdlib/src/collections/map.pace";

func main() {
    final list := List<Int>();
    list.push(1);
    list.push(2);
    list.push(3);
    
    final a := list.get(0).unwrap();
    final len := list.len();

    final map := Map<String, Int>();
    final keyA := "a";
    final keyB := "b";
    map.set(keyA, 1);
    map.set(keyB, 2);

    final b := map.get(keyA).unwrap();
    final keys := map.keys();
    final keyLen := keys.len();
}
