

func testErr(): Result<Int, String> {
    return Err("Failed to perform action");
}

func testOk(): Result<Int, String> {
    return Ok(42);
}

func mainOk(): Result<Int, String> {
    let val = testOk()?;
    return Ok(val * 2);
}

func mainErr(): Result<Int, String> {
    let val = testErr()?;
    return Ok(val * 2);
}

func main() {
    let a = mainOk();
    let b = mainErr();

    match a {
        Ok(v) => print(v),
        Err(e) => print(e),
    }

    match b {
        Ok(v) => print(v),
        Err(e) => print(e),
    }
}
