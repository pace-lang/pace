

func testErr(): Result<Int, String> {
    return Err("Failed to perform action");
}

func testOk(): Result<Int, String> {
    return Ok(42);
}

func mainOk(): Result<Int, String> {
    final val := testOk()?;
    return Ok(val * 2);
}

func mainErr(): Result<Int, String> {
    final val := testErr()?;
    return Ok(val * 2);
}

func main() {
    final a := mainOk();
    final b := mainErr();

    match a {
        Ok(v) => print(v),
        Err(e) => print(e),
    }

    match b {
        Ok(v) => print(v),
        Err(e) => print(e),
    }
}
