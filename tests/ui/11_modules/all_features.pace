// --- Variables and Data Types ---
let greeting: String = "Welcome to Pace!";
var counter: Int = 10;
let pi: Float = 3.14159;
let isAwesome: Boolean = true;

print(greeting);
print("Pi is approximately", pi);

// --- Functions and Control Flow ---
func calculate_factorial(n: Int): Int {
    var result = 1;
    var current = n;
    
    while current > 0 {
        result = result * current;
        current = current - 1;
    }
    
    return result;
}

let fact5 = calculate_factorial(5);
print("Factorial of 5 is:", fact5);

func check_magnitude(num: Int) {
    if num > 10 {
        print(num, "is greater than 10");
    } else {
        print(num, "is 10 or less");
    }
}

check_magnitude(fact5);
check_magnitude(counter);

// --- Classes and Objects ---
class BankAccount {
    var owner: String;
    var balance: Float;

    init(owner: String, initialDeposit: Float) {
        self.owner = owner;
        self.balance = initialDeposit;
    }

    func deposit(amount: Float) {
        self.balance = self.balance + amount;
        print("Deposited", amount, "New balance:", self.balance);
    }

    func withdraw(amount: Float) {
        if self.balance > amount {
            self.balance = self.balance - amount;
            print("Withdrew", amount, "Remaining balance:", self.balance);
        } else {
            print("Insufficient funds for", self.owner);
        }
    }
}

let aliceAccount = BankAccount("Alice", 100.5);
print("Account owner:", aliceAccount.owner);
aliceAccount.deposit(50.25);
aliceAccount.withdraw(200.0);
aliceAccount.withdraw(30.0);

// --- Generics ---
class Box<T> {
    var value: T;

    init(value: T) {
        self.value = value;
    }
}

let intBox = Box(10); // Inferred Box<Int>
print("Int Box value:", intBox.value);

let stringBox = Box("Hello Generics!"); // Inferred Box<String>
print("String Box value:", stringBox.value);

let explicitBox = Box<Int>(42); // Explicit Type Argument
print("Explicit Box value:", explicitBox.value);

func identity<T>(val: T): T {
    return val;
}

let idVal = identity(99);
print("Identity value:", idVal);

// --- Interfaces ---
interface Drawable {
    func draw()
}

class Circle implements Drawable {
    var radius: Float;

    init(radius: Float) {
        self.radius = radius;
    }

    func draw() {
        print("Drawing a circle with radius:", self.radius);
    }
}

class Square implements Drawable {
    var side: Int;

    init(side: Int) {
        self.side = side;
    }

    func draw() {
        print("Drawing a square with side:", self.side);
    }
}

func render(item: Drawable) {
    item.draw();
}

let c = Circle(5.5);
let s = Square(10);

render(c);
render(s);
