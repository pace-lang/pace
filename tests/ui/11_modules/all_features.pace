// --- Variables and Data Types ---
final greeting: String = "Welcome to Pace!";
var counter: Int = 10;
final pi: Float = 3.14159;
final isAwesome: Bool = true;

print(greeting);
print("Pi is approximately", pi);

// --- Functions and Control Flow ---
func calculateFactorial(n: Int): Int {
    result := 1;
    current := n;
    
    while current > 0 {
        result = result * current;
        current = current - 1;
    }
    
    return result;
}

final fact5 := calculateFactorial(5);
print("Factorial of 5 is:", fact5);

func checkMagnitude(num: Int) {
    if num > 10 {
        print(num, "is greater than 10");
    } else {
        print(num.toString() + " is 10 or less");
    }
}

checkMagnitude(fact5);
checkMagnitude(counter);

// --- Classes and Objects ---
class BankAccount {
    owner: String;
    balance: Float;

    func init(owner: String, initialDeposit: Float) {
        self.owner = owner;
        self.balance = initialDeposit;
    }

    func deposit(amount: Float) {
        self.balance = self.balance + amount;
        print("Deposited " + amount.toString() + " New balance: " + self.balance.toString());
    }

    func withdraw(amount: Float) {
        if self.balance > amount {
            self.balance = self.balance - amount;
            print("Withdrew " + amount.toString() + " Remaining balance: " + self.balance.toString());
        } else {
            print("Insufficient funds for " + self.owner);
        }
    }
}

final aliceAccount := BankAccount("Alice", 100.5);
print("Account owner: " + aliceAccount.owner);
aliceAccount.deposit(50.25);
aliceAccount.withdraw(200.0);
aliceAccount.withdraw(30.0);

// --- Generics ---
class Box<T> {
    value: T;

    func init(value: T) {
        self.value = value;
    }
}

final intBox := Box(10); // Inferred Box<Int>
print("Int Box value: " + intBox.value.toString());

final stringBox := Box("Hello Generics!"); // Inferred Box<String>
print("String Box value: " + stringBox.value);

final explicitBox := Box<Int>(42); // Explicit Type Argument
print("Explicit Box value: " + explicitBox.value.toString());

func identity<T>(val: T): T {
    return val;
}

final idVal := identity(99);
print("Identity value: " + idVal.toString());

// --- Interfaces ---
interface Drawable {
    func draw();
}

class Circle implements Drawable {
    radius: Float;

    func init(radius: Float) {
        self.radius = radius;
    }

    func draw() {
        print("Drawing a circle with radius: " + self.radius.toString());
    }
}

class Square implements Drawable {
    side: Int;

    func init(side: Int) {
        self.side = side;
    }

    func draw() {
        print("Drawing a square with side: " + self.side.toString());
    }
}

func render(item: Drawable) {
    item.draw();
}

final c := Circle(5.5);
final s := Square(10);

render(c);
render(s);
