class MathUtils {
    static final Pi := 3.14159;
    static lastCalculation := 0;

    static func add(a: Int, b: Int): Int {
        final result := a + b;
        MathUtils.lastCalculation = result;
        return result;
    }
}

struct Point {
    static final OriginX: Int  = 0;
    static final OriginY: Int  = 0;
    
    x: Int;
    y: Int;
    
    func init(x: Int, y: Int) {
        self.x = x;
        self.y = y;
    }
    
    static func createOrigin(): Point {
        return Point(Point.OriginX, Point.OriginY);
    }
}

enum MyStatus {
    Success,
    Failure,
    
    static func getDefault(): MyStatus {
        return MyStatus.Success();
    }
}

func main() {
    print(MathUtils.Pi);
    print(MathUtils.lastCalculation);
    
    final sum := MathUtils.add(10, 20);
    print(sum);
    print(MathUtils.lastCalculation);
    
    final p := Point.createOrigin();
    print(p.x);
    print(p.y);
    
    final defaultStatus := MyStatus.getDefault();
}
