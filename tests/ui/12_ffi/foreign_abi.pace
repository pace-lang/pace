foreign func putchar(c: CInt): CInt;
foreign func rand(): CInt;

func main() {
    // Print 'H', 'i', '\n'
    putchar(72);
    putchar(105);
    putchar(10);
    
    // Generate a random number
    let r = rand();
    if r > 0 {
        // Just checking that rand works and returns something positive
        putchar(82); // 'R'
        putchar(10); // '\n'
    }
}
