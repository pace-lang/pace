

func main() {
    final okRes: Result<Int, String>  = Result.Ok(42);
    final errRes: Result<Int, String>  = Result.Err("error");

    if okRes.isOk() {
        printInt(okRes.unwrap());
    }

    if errRes.isErr() {
        print(errRes.unwrapErr());
    }

    final defaultVal := errRes.unwrapOr(100);
    printInt(defaultVal);
}
