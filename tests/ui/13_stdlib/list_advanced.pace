func main() {
    final list := List<Int>();
    list.push(1);
    list.push(2);
    list.push(3);
    list.push(4);
    list.push(5);
    
    print("List Length:");
    print(list.len());
    
    final list2 := List<String>();
    list2.push("Hello");
    list2.push("World");
    
    print("String List Length:");
    print(list2.len());
    
    final popped := list2.pop();
    if popped.isSome() {
        print("Popped:");
        final last := popped.unwrap();
        print(last);
    }
}
