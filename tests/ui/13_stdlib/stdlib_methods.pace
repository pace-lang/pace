
func main() {
    final s := "hello";
    final l := s.len();
    print("string len:");
    print(l);
    final s2 := s.concat(" world");
    print("string concat:");
    print(s2);
    final sub := s2.substring(0, 5);
    print("string substring:");
    print(sub);

    final arr: [Int] = [1];
    arr.push(10);
    print("array get 1:");
    print(arr.get(1));
    print("array pop:");
    print(arr.pop());

    final m := Map<String, Int>();
    m.set("key", 42);
    print("map get:");
    print(m.get("key"));
    print("map contains:");
    print(m.contains("key"));
    m.remove("key");
    print("map contains after remove:");
    print(m.contains("key"));
    
    final fRes := open("test.txt", "w");
    match fRes {
        Ok(f) => print(f.write("Hello from Pace!")),
        Err(e) => print(e)
    };
    
    final f2Res := open("test.txt", "r");
    match f2Res {
        Ok(f2) => print(f2.readAll()),
        Err(e) => print(e)
    };
}
