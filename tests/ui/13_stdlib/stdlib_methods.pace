
func main() {
    let s = "hello";
    let l = s.len();
    print("string len:");
    print(l);
    let s2 = s.concat(" world");
    print("string concat:");
    print(s2);
    let sub = s2.substring(0, 5);
    print("string substring:");
    print(sub);

    let arr: [Int] = [1];
    arr.push(10);
    print("array get 1:");
    print(arr.get(1));
    print("array pop:");
    print(arr.pop());

    let m = Map<String, Int>();
    m.set("key", 42);
    print("map get:");
    print(m.get("key"));
    print("map contains:");
    print(m.contains("key"));
    m.remove("key");
    print("map contains after remove:");
    print(m.contains("key"));
    
    let fRes = open("test.txt", "w");
    match fRes {
        Ok(f) => print(f.write("Hello from Pace!")),
        Err(e) => print(e)
    };
    
    let f2Res = open("test.txt", "r");
    match f2Res {
        Ok(f2) => print(f2.readAll()),
        Err(e) => print(e)
    };
}
