func main() {
    print(5.bitAnd(3));
    print(5.bitOr(3));
    print(5.bitXor(3));
    print(5.bitNot());
    print(5.shl(1));
    print(5.shr(1));

    // Math methods
    final a: Int = -42;
    print(a.abs());
    print(10.min(20));
    print(10.max(20));
    print(2.pow(3));

    // Parse methods
    final val: Option<Int> = parseInt("12345");
    print(val.unwrapOr(0));

    final invalid: Option<Int> = parseInt("hello");
    print(invalid.isNone());
}
