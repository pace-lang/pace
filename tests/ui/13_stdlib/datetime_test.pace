import "../../../stdlib/src/core/datetime.pace";
import "../../../stdlib/src/io/print.pace";

func main() {
    let now = DateTime.now();
    
    if now.year >= 2024 {
        print("Year is valid");
    }
    
    if now.month >= 1 && now.month <= 12 {
        print("Month is valid");
    }
    
    if now.day >= 1 && now.day <= 31 {
        print("Day is valid");
    }
    
    if now.hour >= 0 && now.hour <= 23 {
        print("Hour is valid");
    }
    
    if now.minute >= 0 && now.minute <= 59 {
        print("Minute is valid");
    }
    
    if now.second >= 0 && now.second <= 59 {
        print("Second is valid");
    }
    
    if now.millisecond >= 0 && now.millisecond <= 999 {
        print("Millisecond is valid");
    }
    
    let start = DateTime.now().timestamp;
    DateTime.sleep(10.0);
    let end = DateTime.now().timestamp;
    if end > start {
        print("Sleep and timestamps work");
    }
}
