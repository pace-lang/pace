
func testOk(): Result<String, Int> {
    return Ok("success");
}

func testErr(): Result<String, Int> {
    return Err(404);
}

func testSome(): Option<String> {
    return Some("value");
}

func testNone(): Option<String> {
    return None();
}
func main() { testOk(); testErr(); testSome(); testNone(); }
