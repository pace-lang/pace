
func main() {
    final s := "Hello World";
    
    print("toLower:");
    print(s.toLower());

    print("toUpper:");
    print(s.toUpper());

    final replaced := s.replace("World", "Pace");
    print("replace:");
    print(replaced);

    final spaced := "   Pace   ";
    print("trim:");
    print(spaced.trim());

    final csv := "a,b,c";
    final parts := csv.split(",");
    print("split len:");
    print(parts.len());
    final opt0 := parts.get(0);
    if opt0.isSome() {
        print(opt0.unwrap());
    }
    final opt1 := parts.get(1);
    if opt1.isSome() {
        print(opt1.unwrap());
    }
    final opt2 := parts.get(2);
    if opt2.isSome() {
        print(opt2.unwrap());
    }

    // Edge cases
    final optOut := parts.get(10);
    if optOut.isNone() {
        print("out of bounds is None");
    }

    parts.remove(1);
    print("after remove len:");
    print(parts.len());

    parts.clear();
    print("after clear len:");
    print(parts.len());
}
