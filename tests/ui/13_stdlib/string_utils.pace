
func main() {
    let s = "Hello World";
    
    print("toLower:");
    print(s.toLower());

    print("toUpper:");
    print(s.toUpper());

    let replaced = s.replace("World", "Pace");
    print("replace:");
    print(replaced);

    let spaced = "   Pace   ";
    print("trim:");
    print(spaced.trim());

    let csv = "a,b,c";
    let parts = csv.split(",");
    print("split len:");
    print(parts.len());
    let opt0 = parts.get(0);
    if opt0.isSome() {
        print(opt0.unwrap());
    }
    let opt1 = parts.get(1);
    if opt1.isSome() {
        print(opt1.unwrap());
    }
    let opt2 = parts.get(2);
    if opt2.isSome() {
        print(opt2.unwrap());
    }

    // Edge cases
    let opt_out = parts.get(10);
    if opt_out.isNone() {
        print("out of bounds is None");
    }

    parts.remove(1);
    print("after remove len:");
    print(parts.len());

    parts.clear();
    print("after clear len:");
    print(parts.len());
}
