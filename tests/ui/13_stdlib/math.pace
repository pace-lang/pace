
func main() {
    // We don't have robust float printing yet, so we cast to Int or do comparisons
    let s = math::sqrt(16.0);
    if s > 3.9 && s < 4.1 {
        print("sqrt(16) is 4");
    }

    let p = math::pow(2.0, 3.0);
    if p > 7.9 && p < 8.1 {
        print("pow(2, 3) is 8");
    }

    let a = math::abs(-10.5);
    if a > 10.4 && a < 10.6 {
        print("abs(-10.5) is 10.5");
    }

    print("Math ok!");
}
