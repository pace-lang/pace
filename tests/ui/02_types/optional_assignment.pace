class Address {
    city: String;
}

class User {
    address: Address?;
}

func main() {
    final u: User?  = null;
    final s: String?  = "hello";
    final emptyStr: String?  = null;
    
    // Valid assignments
    final u2: User? = u;
    
    // Implicit promotion
    final s2: String? = "world";
    
    print(s != null);
    print(emptyStr == null);
}
