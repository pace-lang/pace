class Address {
    var city: String;
}

class User {
    var address: Address?;
}

func main() {
    let u: User? = null;
    let s: String? = "hello";
    let emptyStr: String? = null;
    
    // Valid assignments
    let u2: User? = u;
    
    // Implicit promotion
    let s2: String? = "world";
    
    print(s != null);
    print(emptyStr == null);
}
