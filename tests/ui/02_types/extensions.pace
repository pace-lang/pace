extend String {
    func shout(): String {
        return self + "!!!";
    }
}

class MyBox<T> {
    item: T;
    func init(val: T) {
        self.item = val;
    }
}

extend<T> MyBox<T> {
    func duplicate(): MyBox<T> {
        return MyBox<T>(self.item);
    }
}

func main() {
    final s := "Hello";
    print(s.shout());

    final l := MyBox<Int>(42);
    final l2 := l.duplicate();
    print(l2.item);
}
