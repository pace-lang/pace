class Address {
    var city: String;
    func init(city: String) {
        self.city = city;
    }
}

class User {
    var address: Address?;
    func init(address: Address?) {
        self.address = address;
    }
}

func main() {
    let addr = Address("New York");
    let u = User(addr);
    
    // Optional chaining
    let c: String? = u?.address?.city;
    print(c);
    
    // Force unwrap
    let unwrappedCity: String = c!;
    print(unwrappedCity);
    
    // Panic on null unwrap
    let nullAddr: Address? = null;
    let city2 = nullAddr?.city; // This is null
    print(city2);
    
    let crash = city2!; // Should trap/panic
}
