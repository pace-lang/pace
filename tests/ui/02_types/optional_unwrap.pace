class Address {
    city: String;
    func init(city: String) {
        self.city = city;
    }
}

class User {
    address: Address?;
    func init(address: Address?) {
        self.address = address;
    }
}

func main() {
    final addr := Address("New York");
    final u: User? = User(addr);
    
    // Optional chaining
    final c: String? = u?.address?.city;
    print(c);
    
    // Force unwrap
    final unwrappedCity: String = c!;
    print(unwrappedCity);
    
    // Panic on null unwrap
    final nullAddr: Address? = null;
    final city2 := nullAddr?.city; // This is null
    print(city2);
    
    final crash := city2!; // Should trap/panic
}
