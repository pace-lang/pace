func main() {
    let intVal: Int = 10;
    print("intVal.toString():", intVal.toString());
    
    let negVal: Int = 0 - 5;
    print("negVal.abs():", negVal.abs());
    
    let floatVal: Float = 3.14;
    print("floatVal.toString():", floatVal.toString());
    print("floatVal.round():", floatVal.round());
    
    let boolVal: Bool = true;
    print("boolVal.toString():", boolVal.toString());
    
    let strVal: String = "hello world";
    print("strVal.len():", strVal.len());
    print("strVal.toUpper():", strVal.toUpper());
}
