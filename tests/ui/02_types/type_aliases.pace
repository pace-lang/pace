type StatusCode = Int;
type Message = String;

func testAlias(code: StatusCode, msg: Message): StatusCode {
    print(msg);
    return code;
}

func main() {
    final x: StatusCode  = 404;
    final s: Message  = "Not Found";
    
    // Type aliases are completely transparent, so passing Int/String directly is fine
    testAlias(200, "OK");
    testAlias(x, s);
}
