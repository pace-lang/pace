struct Rect {
    w: int
    h: int
}

enum Shape {
    Circle(r: float),
    Box(r: Rect),
    Empty
}

fn describe(s: Shape) -> string {
    return match s {
        Circle(r) => "circle",
        Box(r) => "rect",
        Empty => "empty"
    }
}

fn areaOrDefault(s: Shape) -> float {
    return match s {
        Circle(r) => r * r * 3.0,
        _ => 0.0
    }
}

fn main() {
    assert(describe(Shape.Circle(r: 2.0)) == "circle", "inline enum scrutinee + string match")
    assert(describe(Shape.Box(r: Rect(w: 3, h: 4))) == "rect", "struct payload enum match")
    assert(describe(Shape.Empty) == "empty", "unit variant enum match")

    let a = areaOrDefault(Shape.Circle(r: 2.0))
    assert(a > 11.9 && a < 12.1, "float match return")
    let b = areaOrDefault(Shape.Empty)
    assert(b > -0.1 && b < 0.1, "catch-all float match return")

    let extracted = match Shape.Box(r: Rect(w: 5, h: 6)) {
        Circle(r) => Rect(w: 0, h: 0),
        Box(r) => r,
        Empty => Rect(w: 1, h: 1)
    }
    assert(extracted.w == 5 && extracted.h == 6, "struct match return")

    let optRadius1: float? = match Shape.Empty {
        Empty => null,
        Circle(r) => r,
        Box(r) => 1.0
    }
    assert(optRadius1 == null, "match arm null then T")

    let optRadius2: float? = match Shape.Circle(r: 3.5) {
        Circle(r) => r,
        _ => null
    }
    assert(optRadius2 != null && (optRadius2 ?? 0.0) == 3.5, "match arm T then null")

    let optStr: string? = null
    let msg = "${optStr ?? "none"}"
    assert(msg == "none", "nested string in interpolation")
}
