class ScopeGuard {
    v: int
    init(v: int) {
        self.v = v
    }
}

fn findInMatrix(mat: List<List<int>>, target: int) -> int {
    for row in mat {
        let guard = ScopeGuard(10)
        for col in row {
            if col < 0 {
                break
            }
            if col % 2 == 1 {
                continue
            }
            if col == target {
                return col + guard.v
            }
        }
    }
    return -1
}

fn fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let mat = [[2, -1, 8], [1, 3, 6, 8]]
    assert(findInMatrix(mat, 8) == 18, "break skips -1 row, continue skips odds, early return releases RAII")
    assert(findInMatrix(mat, 99) == -1, "missing target returns -1")

    var wi = 0
    var wsum = 0
    while wi < 6 {
        wi = wi + 1
        if wi == 3 || wi == 5 {
            continue
        }
        wsum = wsum + wi
    }
    assert(wsum == 1 + 2 + 4 + 6, "while loop with continue")
    assert(fib(8) == 21, "recursive fibonacci")
}
