struct Point {
    x: int
    y: int
}

enum Shape {
    Circle(r: float),
    Rect(p: Point),
    Empty
}

fn unwrapOptResult(flag: bool) -> Result<int?, string> {
    if !flag {
        return error("bad")
    }
    let inner: int? = 42
    return ok(inner)
}

fn useOptResult(flag: bool) -> Result<int?, string> {
    let v = unwrapOptResult(flag)?
    return ok(v)
}

fn floatResult(okFlag: bool) -> Result<float, string> {
    if !okFlag {
        return error("nope")
    }
    return ok(3.5)
}

fn useFloatResult(okFlag: bool) -> Result<float, string> {
    let f = floatResult(okFlag)?
    return ok(f * 2.0)
}

fn main() {
    // 1. Result<float, E> + ?
    let fr = useFloatResult(true)
    assert(fr.isOk(), "float result is ok")

    // 2. Empty collections & for-in break/continue
    let emptyList: List<int> = []
    assert(emptyList.isEmpty, "empty list isEmpty")
    assert(!emptyList.isNotEmpty, "empty list !isNotEmpty")
    assert(emptyList.slice(0, 5).len == 0, "empty list slice")
    assert(emptyList.reversed().len == 0, "empty list reversed")
    var emptyCount = 0
    for item in emptyList {
        emptyCount = emptyCount + item
    }
    assert(emptyCount == 0, "for-in on empty list runs 0 times")

    let nums = [1, 2, 3, 4, 5]
    var sum = 0
    for n in nums {
        if n == 2 {
            continue
        }
        if n == 5 {
            break
        }
        sum = sum + n
    }
    assert(sum == 1 + 3 + 4, "for-in continue and break")

    // 3. String edge cases & % in interpolation
    let pct = 100
    let pctMsg = "${pct}% complete"
    assert(pctMsg == "100% complete", "% in interpolated string")
    let emptyStr = ""
    assert(emptyStr.isEmpty, "empty string isEmpty")
    assert(emptyStr.slice(-5, 100) == "", "empty string slice")
    assert("abc".slice(-2, 99) == "abc", "clamped slice")
    assert("a,b,".split(",").len == 3, "trailing delimiter split")
    assert("hello".replace("xyz", "123") == "hello", "replace no match")

    // 4. Enum match with float & struct payloads
    let s1 = Shape.Circle(r: 2.5)
    let area = match s1 {
        Circle(r) => r * 2.0,
        Rect(p) => 0.0,
        Empty => 0.0
    }
    assert((area > 4.9) && (area < 5.1), "enum match float payload")

    let s2 = Shape.Rect(p: Point(x: 3, y: 4))
    let px = match s2 {
        Circle(r) => 0,
        Rect(p) => p.x + p.y,
        Empty => -1
    }
    assert(px == 7, "enum match struct payload")

    // 5. Result<int?, E> + ?
    let or1 = useOptResult(true)
    assert(or1.isOk(), "Result<int?, string> ? works")

    // 6. Result<Struct, E> and Result<List<int>, E> + ?
    let pr = usePointResult(true)
    assert(pr.isOk(), "Result<Point, string> ? works")
    let lr = useListResult(true)
    assert(lr.isOk(), "Result<List<int>, string> ? works")

    // 7. Closures returning closures and capturing collections/strings
    let add10 = makeAdder(10)
    assert(add10(5) == 15, "returned closure captures int")

    let prefix = "hi"
    let items = [10, 20, 30]
    let fnCap = (i: int) -> string => {
        let v = items[i]
        return "${prefix}:${v}"
    }
    assert(fnCap(1) == "hi:20", "closure captures string and List")

    if true {
        return
    }
    // 8. Map resize + remove + re-insert (tombstone stress)
    let m: Map<string, int> = {}
    var i = 0
    while i < 40 {
        m["k${i}"] = i
        i = i + 1
    }
    assert(m.len == 40, "map resize len 40")
    var j = 0
    while j < 20 {
        m.remove("k${j}")
        j = j + 1
    }
    assert(m.len == 20, "map after 20 removes")
    m["k0"] = 999
    assert(m.len == 21 && m.getOrDefault("k0", -1) == 999, "map reinsert over tombstone")
    assert(m.keys().len == 21 && m.values().len == 21, "map keys/values len")

    // 9. Set for-in with continue/break + StringBuilder realloc/clear
    let s: Set<string> = Set()
    s.add("a")
    s.add("b")
    s.add("c")
    var seen = 0
    for item in s {
        if item == "b" {
            continue
        }
        seen = seen + 1
    }
    assert(seen == 2, "Set for-in continue")

    let sb = StringBuilder()
    var k = 0
    while k < 30 {
        sb.append("xy")
        k = k + 1
    }
    assert(sb.len == 60, "StringBuilder realloc len")
    sb.clear()
    assert(sb.isEmpty, "StringBuilder clear isEmpty")
    sb.append("ok")
    assert(sb.toString() == "ok", "StringBuilder reuse after clear")
}

fn makePointResult(flag: bool) -> Result<Point, string> {
    if !flag {
        return error("err")
    }
    return ok(Point(x: 7, y: 8))
}

fn usePointResult(flag: bool) -> Result<int, string> {
    let p = makePointResult(flag)?
    return ok(p.x + p.y)
}

fn makeListResult(flag: bool) -> Result<List<int>, string> {
    if !flag {
        return error("err")
    }
    return ok([1, 2, 3])
}

fn useListResult(flag: bool) -> Result<int, string> {
    let xs = makeListResult(flag)?
    return ok(xs.len())
}

fn makeAdder(base: int) -> (int) -> int {
    return (x: int) -> int => base + x
}
