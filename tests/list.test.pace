fn main() {
    let xs = [10, 20, 30]
    println(xs.len())
    println(xs[0])
    println(xs[1])
    println(xs[2])

    xs.push(40)
    println(xs.len())
    println(xs[3])

    xs[1] = 99
    println(xs[1])

    let popped = xs.pop()
    println(popped)
    println(xs.len())

    for item in xs {
        println(item)
    }

    xs.clear()
    println(xs.len())

    let ys = List<int>()
    ys.push(100)
    ys.push(200)
    println(ys.len())
    println(ys[0])
    println(ys[1])
}
