fn main() {
    let xs = [10, 20, 30]
    assert(xs.len() == 3, "Initial length must be 3")
    assert(xs[0] == 10)
    assert(xs[1] == 20)
    assert(xs[2] == 30)

    xs.push(40)
    assert(xs.len() == 4)
    assert(xs[3] == 40)

    xs[1] = 99
    assert(xs[1] == 99)

    let popped = xs.pop()
    assert(popped == 40)
    assert(xs.len() == 3)

    var sum = 0
    for item in xs {
        sum = sum + item
    }
    assert(sum == 139)

    xs.clear()
    assert(xs.len() == 0)

    let ys = List<int>()
    ys.push(100)
    ys.push(200)
    assert(ys.len() == 2)
    assert(ys[0] == 100)
    assert(ys[1] == 200)
}
