fn main() {
    let scores = {"alice": 100, "bob": 200}
    println(scores.len())
    println(scores["alice"])
    println(scores["bob"])

    scores["charlie"] = 300
    println(scores.len())
    println(scores["charlie"])

    scores["bob"] = 250
    println(scores["bob"])

    println(scores.has("alice"))
    println(scores.has("dave"))

    scores.remove("alice")
    println(scores.len())
    println(scores.has("alice"))

    scores.clear()
    println(scores.len())

    let counts = Map<int, int>()
    counts[1] = 10
    counts[2] = 20
    counts[42] = 999
    println(counts.len())
    println(counts[1])
    println(counts[2])
    println(counts[42])
    println(counts.has(42))
    println(counts.has(99))

    counts.remove(2)
    println(counts.len())
    println(counts.has(2))
}
