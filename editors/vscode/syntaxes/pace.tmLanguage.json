{
  "name": "pace",
  "scopeName": "source.pace",
  "patterns": [
    {
      "match": "\\b(func|let|var|if|else|while|for|in|return|class|interface|implements|enum|match|break|continue|weak|foreign|init)\\b",
      "name": "keyword.control.pace"
    },
    {
      "match": "\\b(Int|Float|Boolean|String|Void|Array|Option|Result|Map|File)\\b",
      "name": "support.type.pace"
    },
    {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.pace"
    },
    {
      "match": "\".*?\"",
      "name": "string.quoted.double.pace"
    },
    {
      "match": "//.*",
      "name": "comment.line.double-slash.pace"
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.pace"
    },
    {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.pace"
    },
    {
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
      "name": "entity.name.type.class.pace"
    },
    {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.pace"
    }
  ]
}
