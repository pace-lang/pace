import "math_utils";

// Test Enum
enum Status {
    Active,
    Inactive
}

// Test Interface
interface Greeter {
    func greet() -> String;
}

// Test Class
class Person implements Greeter {
    var name: String;
    var age: Int;

    func init(name: String, age: Int) {
        self.name = name;
        self.age = age;
    }

    func greet() -> String {
        return "Hello, my name is ${self.name} and I am ${self.age} years old.";
    }
}

// Test Function
func is_adult(age: Int) -> Boolean {
    if age >= 18 {
        return true;
    } else {
        return false;
    }
}

func main() {
    // 1. Data Types
    var int_val: Int = 42;
    var float_val: Float = 3.14;
    var bool_val: Boolean = true;
    var string_val: String = "Pace Language";
    var array_val: [Int] = [1, 2, 3, 4, 5];

    print("--- Data Types ---");
    print(int_val);
    print(float_val);
    print(bool_val);
    print(string_val);

    // 2. Conditions
    print("--- Conditions ---");
    if is_adult(int_val) {
        print("Is an adult!");
    } else {
        print("Is not an adult.");
    }

    // 3. Loops
    print("--- Loops ---");
    print("For Loop (Range):");
    for i in 0..3 {
        print(i);
    }

    print("For Loop (Array):");
    for item in array_val {
        print(item);
    }

    print("While Loop:");
    var counter: Int = 0;
    while counter < 3 {
        print(counter);
        counter = counter + 1;
    }

    // 4. Enums
    print("--- Enums ---");
    var current_status: Status = Status.Active;
    print(current_status); // Enums might not support print directly yet, we will see

    // 5. Classes and Interfaces
    print("--- Classes & Interfaces ---");
    var p = Person("Alice", 25);
    print(p.greet());

    print("--- Imports ---");
    var result = add(10, 5);
    print(result);
}
