# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Java
*.class

# Pace CLI build cache
**/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Ignore all markdown files in the repository
*.md
# But explicitly allow README.md and benchmark results
!README.md
!benchmarks/BENCHMARK_RESULTS.md

# Ignore IDE configs
.idea/
.vscode/

# VS Code Extension & Node.js
node_modules/
editors/vscode/out/
*.vsix

# Local examples and test projects
build/
test_output_dir/

# Benchmark build artifacts
benchmarks/**/build/
benchmarks/**/bench
benchmarks/**/bench_*
benchmarks/**/bench.c
benchmarks/**/bench.o
benchmarks/**/Bench.class

