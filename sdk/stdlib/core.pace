// Core Compiler Intrinsics
// These structs are backed by native compiler representations (I64, F64, etc.)
// They exist here so developers can attach methods to them.
struct Int {}
struct Float {}
struct Bool {}
struct String {}
struct Char {}
struct Byte {}

// Type System constructs
struct Void {}
struct Any {}
struct Never {}
struct Error {}

// Option and Result Algebraic Data Types
enum Option<T> {
    Some(T),
    None,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

// Fundamental Protocols
interface Equatable {
    func equals(other: Self) -> Bool
}

interface Comparable {
    func compareTo(other: Self) -> Int
}

interface Hashable {
    func hash() -> Int
}

interface Display {
    func display() -> String
}

interface Debug {
    func debug() -> String
}

interface Clone {
    func clone() -> Self
}

interface Default {
    // Note: Pace currently doesn't support static interface methods properly
    // but defining this as a placeholder for when static methods are added.
    // static func default() -> Self
}

interface Iterable<T> {
    func length() -> Int;
}
