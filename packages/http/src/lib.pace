import "std/core/string.pace";
import "std/core/string_builder.pace";
import "std/core/option.pace";
import "std/collections/list.pace";
import "std/net/socket.pace";

enum HttpStatus {
    StatusOk,
    StatusCreated,
    StatusBadRequest,
    StatusNotFound,
    StatusInternalServerError
}

extend HttpStatus {
    func toInt(): Int {
        return match self {
            HttpStatus.StatusOk() => 200,
            HttpStatus.StatusCreated() => 201,
            HttpStatus.StatusBadRequest() => 400,
            HttpStatus.StatusNotFound() => 404,
            HttpStatus.StatusInternalServerError() => 500,
            _ => 500
        };
    }
}

class HttpServerResponse {
    var status: Int;
    var body: String;
    var headers: List<String>;
    
    func init(status: Int, body: String) {
        self.status = status;
        self.body = body;
        self.headers = List<String>();
    }
    
    func addHeader(key: String, value: String) {
        self.headers.push(key + ": " + value);
    }
    
    func setJson(jsonBody: String) {
        self.addHeader("Content-Type", "application/json");
        self.body = jsonBody;
    }

    func setHtml(htmlBody: String) {
        self.addHeader("Content-Type", "text/html");
        self.body = htmlBody;
    }
    
    func toString(): String {
        let builder = StringBuilder();
        builder.append("HTTP/1.1 ");
        builder.append(self.status.toString());
        if self.status == 200 {
            builder.append(" OK\r\n");
        } else if self.status == 404 {
            builder.append(" Not Found\r\n");
        } else if self.status == 500 {
            builder.append(" Internal Server Error\r\n");
        } else {
            builder.append(" Unknown\r\n");
        }
        
        var i = 0;
        while i < self.headers.len() {
            builder.append(self.headers.get(i).unwrap());
            builder.append("\r\n");
            i = i + 1;
        }
        
        builder.append("Content-Length: ");
        builder.append(self.body.len().toString());
        builder.append("\r\n\r\n");
        builder.append(self.body);
        
        return builder.toString();
    }
}

class HttpRequest {
    var method: String;
    var path: String;
    var stream: TcpStream;
    var isValid: Boolean;
    
    func init() {
        self.method = "";
        self.path = "";
        self.stream = TcpStream();
        self.isValid = false;
    }
    
    func respondWith(resp: HttpServerResponse) {
        let respStr = resp.toString();
        self.stream.writeString(respStr);
        self.stream.close();
    }
    
    func getQueryParam(key: String): Option<String> {
        let queryStart = self.path.indexOfFrom("?", 0);
        if queryStart == -1 {
            return Option.None();
        }
        let queryString = self.path.substring(queryStart + 1, self.path.len());
        
        var paramsStart = 0;
        while paramsStart < queryString.len() {
            let nextAmp = queryString.indexOfFrom("&", paramsStart);
            var paramEnd = queryString.len();
            if nextAmp != -1 {
                paramEnd = nextAmp;
            }
            let param = queryString.substring(paramsStart, paramEnd);
            let eqIdx = param.indexOfFrom("=", 0);
            if eqIdx != -1 {
                let pKey = param.substring(0, eqIdx);
                if pKey == key {
                    return Option.Some(param.substring(eqIdx + 1, param.len()));
                }
            }
            if nextAmp == -1 {
                paramsStart = queryString.len();
            } else {
                paramsStart = nextAmp + 1;
            }
        }
        return Option.None();
    }
}

class HttpServer {
    var listener: TcpListener;
    
    func init() {
        self.listener = TcpListener();
    }
    
    func bind(addr: String): Boolean {
        return self.listener.bind(addr);
    }
    
    func accept(): HttpRequest {
        let stream = self.listener.accept();
        let req = HttpRequest();
        req.stream = stream;
        
        let requestStr = stream.readString(4096);
        if requestStr != "" {
            let space1 = requestStr.indexOfFrom(" ", 0);
            if space1 != -1 {
                req.method = requestStr.substring(0, space1);
                let space2 = requestStr.indexOfFrom(" ", space1 + 1);
                if space2 != -1 {
                    req.path = requestStr.substring(space1 + 1, space2);
                    req.isValid = true;
                }
            }
        }
        return req;
    }
    
    func close() {
        self.listener.close();
    }
}

func bindHttpServer(addr: String): HttpServer {
    let server = HttpServer();
    let success = server.bind(addr);
    if success == false {
        print("Failed to bind server");
    }
    return server;
}

class ClientHttpRequest {
    var method: String;
    var url: String;
    
    func init(method: String, url: String) {
        self.method = method;
        self.url = url;
    }
}

class HttpResult {
    var ok: Boolean;
    var value: HttpServerResponse;
    
    func init(ok: Boolean, value: HttpServerResponse) {
        self.ok = ok;
        self.value = value;
    }
    
    func isOk(): Boolean {
        return self.ok;
    }
    
    func unwrap(): HttpServerResponse {
        return self.value;
    }
}

class HttpClientOptions {
    var timeout: Int;
    var userAgent: String;
    
    func init(timeout: Int, userAgent: String) {
        self.timeout = timeout;
        self.userAgent = userAgent;
    }
}

class HttpClient {
    var options: HttpClientOptions;
    
    func init(options: HttpClientOptions) {
        self.options = options;
    }
    
    func send(req: ClientHttpRequest): HttpResult {
        let isHttps = req.url.contains("https://");
        var host = "";
        var path = "/";
        var portStr = "80";
        if isHttps {
            portStr = "443";
        }
        
        var protocolLen = 7;
        if isHttps {
            protocolLen = 8;
        }
        
        let pathIdx = req.url.indexOfFrom("/", protocolLen);
        if pathIdx == -1 {
            host = req.url.substring(protocolLen, req.url.len());
        } else {
            host = req.url.substring(protocolLen, pathIdx);
            path = req.url.substring(pathIdx, req.url.len());
        }
        
        let portIdx = host.indexOfFrom(":", 0);
        if portIdx != -1 {
            portStr = host.substring(portIdx + 1, host.len());
            host = host.substring(0, portIdx);
        }
        
        let stream = TcpStream();
        let connected = stream.connect(host + ":" + portStr);
        
        if connected == false {
            return HttpResult(false, HttpServerResponse(500, "Connection failed"));
        }
        
        let builder = StringBuilder();
        builder.append(req.method);
        builder.append(" ");
        builder.append(path);
        builder.append(" HTTP/1.1\r\nHost: ");
        builder.append(host);
        builder.append("\r\nUser-Agent: ");
        builder.append(self.options.userAgent);
        builder.append("\r\nConnection: close\r\n\r\n");
        
        stream.writeString(builder.toString());
        
        let respStr = stream.readString(65535);
        stream.close();
        
        let bodyStart = respStr.indexOfFrom("\r\n\r\n", 0);
        var body = "";
        if bodyStart != -1 {
            body = respStr.substring(bodyStart + 4, respStr.len());
        }
        
        var status = 200;
        let spaceIdx = respStr.indexOfFrom(" ", 0);
        if spaceIdx != -1 {
            let space2Idx = respStr.indexOfFrom(" ", spaceIdx + 1);
            if space2Idx != -1 {
                let statusStr = respStr.substring(spaceIdx + 1, space2Idx);
                if statusStr == "404" { status = 404; }
                else if statusStr == "500" { status = 500; }
                else if statusStr == "400" { status = 400; }
            }
        }
        
        return HttpResult(true, HttpServerResponse(status, body));
    }
}
