actor Counter {
    var count: Int;

    func init() {
        self.count = 0;
    }

    func increment() {
        self.count = self.count + 1;
    }

    func get_count() -> Int {
        return self.count;
    }
}

func runActorTest() {
    print("--- Testing Actors ---");
    let c = Counter();
    c.increment();
    c.increment();
    print("Actor count: ");
    print(await c.get_count());
}
