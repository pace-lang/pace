import "pace:collections";
func runListTest() {
    print("--- Testing Lists ---");
    let list = List<Int>();
    list.add(10);
    list.add(20);
    list.add(30);
    print("List size: ${list.length()}");
    print("First element: ${list.get(0)}");
    print("Second element: ${list.get(1)}");
    print("Third element: ${list.get(2)}");
    list.drop();
    print("Dropped list");
}

