func divide(a: Int, b: Int) -> Result<Int, String> {
    if b == 0 {
        return Result<Int, String>.Err("Division by zero");
    }
    return Result<Int, String>.Ok(a / b);
}


func runResultReturnTest() -> Result<Int, String> {
    let res = divide(10, 2);
    let val = res?;
    print("10 / 2 result: ");
    print(val);
    return Result<Int, String>.Ok(val);
}

func runResultTest() {
    print("--- Testing Results ---");

    runResultReturnTest();

    let res1 = divide(10, 2);
    match res1 {
        Result.Ok(v) => {
            print("First result: ");
            print(v);
        }
        Result.Err(e) => {
            print("First error: ");
            print(e);
        }
    }
    
    let res2 = divide(10, 0);
    match res2 {
        Result.Ok(v) => {
            print("Second result: ");
            print(v);
        }
        Result.Err(e) => {
            print("Second error: ");
            print(e);
        }
    }
}



