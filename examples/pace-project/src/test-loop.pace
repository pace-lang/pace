import "pace:collections";
func runLoopTest() {
    print("--- Testing Loops ---");
    var i = 0;
    var sum = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    print("Sum of 0 to 4 is: ${sum}");
    print("--- Testing For Loop ---");
    let list = [10, 20, 30];
    var forSum = 0;
    for item in list {
        forSum = forSum + item;
    }
    print("Sum of list is: ${forSum}");
}

