fn hello() {
    println("⚡ Hello from your Pace library!")
}

fn add(a: int, b: int) -> int {
    return a + b
}

fn multiply(a: int, b: int) -> int {
    return a * b
}

class Box<T> {
    var value: T

    fn get() -> T {
        return self.value
    }

    fn set(newValue: T) {
        self.value = newValue
    }
}
