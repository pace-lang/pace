fn main() {
    // 1. List operations
    let numbers = [10, 20, 30]
    assert(numbers.len() == 3, "List length should be 3")
    assert(numbers[0] == 10, "numbers[0] == 10")
    assert(numbers[1] == 20, "numbers[1] == 20")
    assert(numbers[2] == 30, "numbers[2] == 30")

    numbers[1] = 99
    assert(numbers[1] == 99, "numbers[1] after update == 99")

    numbers.push(40)
    assert(numbers.len() == 4, "numbers.len() after push == 4")
    assert(numbers[3] == 40, "numbers[3] == 40")

    let popped = numbers.pop()
    assert(popped == 40, "numbers.pop() == 40")
    assert(numbers.len() == 3, "numbers.len() after pop == 3")

    // 2. Map operations
    let scores = {"alice": 100, "bob": 85}
    assert(scores.len() == 2, "scores.len() == 2")
    assert(scores.has("alice") == true, "scores has alice")
    assert(scores.has("charlie") == false, "scores does not have charlie")
    assert(scores.get("alice") == 100, "scores.get(alice) == 100")

    scores.set("charlie", 95)
    assert(scores.len() == 3, "scores.len() after adding charlie == 3")
    assert(scores.get("charlie") == 95, "scores.get(charlie) == 95")

    scores.remove("bob")
    assert(scores.len() == 2, "scores.len() after removing bob == 2")
    assert(scores.has("bob") == false, "scores no longer has bob")
}

