fn testClosures() {
    println("--- Closures & Lambdas ---")
    let add = (x: int, y: int) => x + y
    let result = add(10, 20)
    println(result)
    let multiply = (a: int, b: int) => a * b
    let prod = multiply(5, 5)
    println(prod)
    // Capture test with block body and type inference
    let baseOffset = 100
    let captureTest = (x: int) => {
        let temp = x + baseOffset
        return temp
    }
    
    let res = captureTest(50)
    println(res)
}
