class Animal {
    name: string

    fn speak() {
        println("Animal noise")
    }
}

class Dog extends Animal {

    override fn speak() {
        println("Woof")
    }
}

fn testInheritance() {
    println("--- Testing Inheritance ---")
    let a = Animal(name: "Generic")
    a.speak()
    let d = Dog(name: "Buddy")
    d.speak()
}
