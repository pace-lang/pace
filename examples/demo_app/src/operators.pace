fn testOperators() {
    println("--- Testing Operators ---")
    let a = 10
    let b = 5
    let add = a + b
    let sub = a - b
    let mul = a * b
    let div = a / b
    let eq = a == b
    let neq = a != b
    let gt = a > b
    let lt = a < b
    let gte = a >= b
    let lte = a <= b
    println("Addition of a + b = $add")
    println("Subtraction of a - b = $sub")
    println("Multiplication of a * b = $mul")
    println("Division of a / b = $div")
    println("Equality of a == b = $eq")
    println("Inequality of a != b = $neq")
    println("Greater than of a > b = $gt")
    println("Less than of a < b = $lt")
    println("Greater than or equal to of a >= b = $gte")
    println("Less than or equal to of a <= b = $lte")
}
