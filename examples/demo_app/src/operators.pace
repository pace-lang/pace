fn testOperators() {
    println("--- Testing Operators ---")
    let a = 10
    let b = 5
    let add = a + b
    let sub = a - b
    let mul = a * b
    let div = a / b
    let _eq = a == b
    let _neq = a != b
    let _gt = a > b
    let _lt = a < b
    let _gte = a >= b
    let _lte = a <= b
    println(add)
    println(sub)
    println(mul)
    println(div)
}
