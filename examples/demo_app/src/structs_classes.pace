struct Point {
    var x: int
    var y: int
}

class Counter {
    static count: int = 0
    var value: int

    fn init() {
        self.value = 0
        Counter.count = Counter.count + 1
    }

    fn increment() {
        self.value = self.value + 1
    }

    fn get() -> int {
        return self.value
    }
}

fn testStructsClasses() {
    println("--- Testing Structs and Classes ---")
    let p = Point(x: 10, y: 20)
    println("Point x: ${p.x}")
    println("Point y: ${p.y}")
    let c = Counter()
    c.increment()
    println("Counter value: ${c.get()}")
    let _c2 = Counter()
    println("Counter count: ${Counter.count}")
}
