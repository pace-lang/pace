struct Point {
    x: int
    y: int
}

class Counter {
    static count: int = 0
    value: int

    fn init() {
        self.value = 0
        Counter.count = Counter.count + 1
    }

    fn increment() {
        self.value = self.value + 1
    }

    fn get() -> int {
        return self.value
    }
}

fn testStructsClasses() {
    println("--- Testing Structs and Classes ---")
    let p = Point(x: 10, y: 20)
    println(p.x)
    let c = Counter()
    c.increment()
    println(c.get())
    let _c2 = Counter()
    println(Counter.count)
}
